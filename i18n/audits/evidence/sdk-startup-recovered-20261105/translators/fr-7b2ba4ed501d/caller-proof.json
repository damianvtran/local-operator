    },
    {
      "line": 590,
      "text": "        # Only refusals pay for locale imports/reads, AFTER public root isolation."
    },
    {
      "line": 591,
      "text": "        # Reuse this already-scoped manager; None would make the resolver build"
    },
    {
      "line": 592,
      "text": "        # another manager (and potentially repair config/load credentials)."
    },
    {
      "line": 593,
      "text": "        from local_operator.i18n.messages import render"
    },
    {
      "line": 594,
      "text": "        from local_operator.i18n.resolve import DEFAULT_LANGUAGE, resolve_language"
    },
    {
      "line": 595,
      "text": ""
    },
    {
      "line": 596,
      "text": "        language = config_manager.get_config().values.get(\"language\")"
    },
    {
      "line": 597,
      "text": "        locale = resolve_language(language if isinstance(language, str) else DEFAULT_LANGUAGE)"
    },
    {
      "line": 598,
      "text": "        return render(message.code, message.params, locale=locale)"
    },
    {
      "line": 599,
      "text": ""
