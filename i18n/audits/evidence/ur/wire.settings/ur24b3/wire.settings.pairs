wire.settings.display_rail.help	ROLE=changed	EN="A rule marks the ANSWER: the message that ends the turn. Mid-turn narration takes no rail."	UR="ایک لکیر ANSWER کو نشان زد کرتی ہے: ٹرن ختم کرنے والا پیغام۔ ٹرن کے دوران کے بیان پر ریل نہیں۔"	OLD="ایک لکیر ANSWER کو نشان زد کرے: ٹرن ختم کرنے والا پیغام۔ ٹرن کے دوران کے بیان پر ریل نہیں۔"
wire.settings.display_rail.label	ROLE=direct_neighbor	EN="Assistant gutter rail"	UR="اسسٹنٹ گٹر ریل"	OLD="اسسٹنٹ گٹر ریل"	NEIGHBOR_REASON=Direct label neighbor for the display-rail factual rule.
wire.settings.display_turn_answer_rail.help	ROLE=direct_neighbor	EN="Draw a thin rule beside the answer that closes a turn (desktop app)."	UR="ٹرن ختم کرنے والے جواب کے پاس پتلی لکیر بنائیں (ڈیسک ٹاپ ایپ)۔"	OLD="ٹرن ختم کرنے والے جواب کے پاس پتلی لکیر بنائیں (ڈیسک ٹاپ ایپ)۔"	NEIGHBOR_REASON=Direct neighboring rule-drawing help; imperative Draw need not match factual marks.
wire.settings.network_audit_max_bytes.help	ROLE=changed	EN="Bytes per generation, after rotation. 8 MiB of gzipped JSONL is roughly 55k records; the five-generation ceiling is therefore ~40 MiB."	UR="گردش کے بعد فی جنیریشن بائٹس۔ 8 MiB gzip شدہ JSONL میں تقریباً 55k ریکارڈز ہوتے ہیں؛ پانچ جنیریشنز کی حد اس لیے ~40 MiB ہے۔"	OLD="گردش کے بعد فی جنیریشن bytes۔ 8 MiB gzip شدہ JSONL میں تقریباً 55k ریکارڈز ہوتے ہیں؛ پانچ جنیریشنز کی حد اس لیے ~40 MiB ہے۔"
wire.settings.proactive.description	ROLE=changed	EN="Bounds for the proactive agent class: how long a hidden patience wait defaults to, how it backs off across re-attempts, and when a cycle must end. Read at the moment a wait is armed or fires."	UR="پیش قدم ایجنٹ قسم کی حدود: پوشیدہ انتظار کی ڈیفالٹ مدت، دوبارہ کوششوں میں بیک آف، اور چکر کب ختم ہو۔ یہ ترتیبات انتظار مقرر یا متحرک ہونے پر پڑھی جاتی ہیں۔"	OLD="پیش قدم ایجنٹ قسم کی حدود: پوشیدہ انتظار کی ڈیفالٹ مدت، دوبارہ کوششوں میں بیک آف، اور چکر کب ختم ہو۔ یہ انتظار مقرر یا متحرک ہونے پر پڑھی جاتی ہیں۔"
wire.settings.proactive.title	ROLE=direct_neighbor	EN="Proactive class"	UR="پیش قدم قسم"	OLD="پیش قدم قسم"	NEIGHBOR_REASON=Direct section-title neighbor for the proactive settings subject.
wire.settings.remote_compute.description	ROLE=changed	EN="Preview: run agent work on Radient-hosted compute, bound to one of your mesh networks."	UR="تجرباتی: ایجنٹ کا کام Radient کے ہوسٹ کیے کمپیوٹ پر چلائیں، آپ کے ایک میش نیٹ ورک سے منسلک۔"	OLD="پیش نظارہ: ایجنٹ کا کام Radient کے ہوسٹ کیے کمپیوٹ پر چلائیں، آپ کے ایک میش نیٹ ورک سے منسلک۔"
wire.settings.remote_compute_enabled.help	ROLE=changed	EN="Preview: sends work to Radient compute, bound to one mesh network."	UR="تجرباتی: کام Radient کمپیوٹ کو بھیجے، ایک میش نیٹ ورک سے منسلک۔"	OLD="پیش نظارہ: کام Radient کمپیوٹ کو بھیجے، ایک میش نیٹ ورک سے منسلک۔"
wire.settings.retry_connectivitybackoffcapms.help	ROLE=changed	EN="Longest wait between connectivity retries."	UR="کنیکٹیوٹی کی دوبارہ کوششوں کے درمیان سب سے طویل انتظار۔"	OLD="کنیکٹیوٹی دوبارہ کوششیں کے درمیان سب سے طویل انتظار۔"
wire.settings.retry_connectivitymaxretries.help	ROLE=direct_neighbor	EN="Patient budget for a machine that went offline; distinct from max retries."	UR="آف لائن مشین کے لیے صبر کا بجٹ؛ زیادہ سے زیادہ دوبارہ کوششوں سے الگ۔"	OLD="آف لائن مشین کے لیے صبر کا بجٹ؛ زیادہ سے زیادہ دوبارہ کوششوں سے الگ۔"	NEIGHBOR_REASON=Direct connectivity-retry family neighbor.
wire.settings.session_cleanup_max_total_bytes.help	ROLE=changed	EN="Needs cleanup on. Trim oldest past this many bytes; 0 = no cap."	UR="صفائی آن ہو۔ اتنے بائٹس سے بڑھنے پر پرانے ہٹائیں؛ 0 = کوئی حد نہیں۔"	OLD="صفائی آن ہو۔ اتنے bytes سے بڑھنے پر پرانے ہٹائیں؛ 0 = کوئی حد نہیں۔"
wire.settings.subagents_max_running.label	ROLE=changed	EN="Max background jobs"	UR="زیادہ سے زیادہ پس منظر جاب"	OLD="زیادہ سے زیادہ پس منظر کام"
wire.settings.subagents_model_choice.choice.operator.label	ROLE=direct_neighbor	EN="the operator"	UR="آپریٹر"	OLD="آپریٹر"	NEIGHBOR_REASON=Direct visible choice label for operator terminology.
wire.settings.subagents_model_choice.help	ROLE=changed	EN="Who picks a subagent's tier; the operator pins one in its profile."	UR="ذیلی ایجنٹ کا درجہ کون منتخب کرے؛ آپریٹر پروفائل میں مقرر کرتا ہے۔"	OLD="ذیلی ایجنٹ کا درجہ کون منتخب کرے؛ operator پروفائل میں مقرر کرتا ہے۔"
wire.settings.supplements_denyprefixes.help	ROLE=changed	EN="Needs Highlights on. Comma-separated folders whose files are never listed or sent to a decision model; use it on a machine holding customer data."	UR="نمایاں حصے آن ہوں۔ کاما سے الگ فولڈرز جن کی فائلیں کبھی فہرست میں نہیں آتیں اور فیصلہ کرنے والے ماڈل کو نہیں بھیجی جاتیں؛ گاہکوں کے ڈیٹا والی مشین پر استعمال کریں۔"	OLD="نمایاں حصے آن ہوں۔ کاما سے الگ فولڈرز جن کی فائلیں کبھی فہرست میں شامل یا فیصلہ ماڈل کو نہیں بھیجتیں؛ گاہکوں کے ڈیٹا والی مشین پر استعمال کریں۔"
wire.settings.supplements_denyprefixes.label	ROLE=direct_neighbor	EN="↳ never list under"	UR="↳ ان کے نیچے کبھی فہرست نہ کریں"	OLD="↳ ان کے نیچے کبھی فہرست نہ کریں"	NEIGHBOR_REASON=Direct label neighbor for the neither-listed-nor-sent safety help.
wire.settings.supplements_maxcostusd.help	ROLE=changed	EN="Needs graphics on. Soft cap on one job's spend."	UR="گرافکس آن ہوں۔ ایک جاب کے خرچ کی نرم حد۔"	OLD="گرافکس آن ہوں۔ ایک کام کے خرچ کی نرم حد۔"
wire.settings.supplements_timeouts.help	ROLE=changed	EN="Needs Highlights on. Give up on a whole job after this long."	UR="نمایاں حصے آن ہوں۔ اتنی دیر بعد پوری جاب چھوڑ دیں۔"	OLD="نمایاں حصے آن ہوں۔ اتنی دیر بعد پورا کام چھوڑ دیں۔"
wire.settings.tui_theme.help	ROLE=changed	EN="Colour ramp. /theme switches it live with an arrow-key preview."	UR="رنگوں کا تسلسل۔ /theme ایرو کیز کے پیش نظارہ کے ساتھ براہ راست بدلتی ہے۔"	OLD="رنگوں کا تسلسل۔ /theme arrow-key پیش نظارہ کے ساتھ براہ راست بدلتی ہے۔"
wire.settings.wakes_triggers_project_staleness_enabled.help	ROLE=changed	EN="Wake to check in on projects whose progress went stale. Settled (done/paused/archived) projects are never watched."	UR="ان پروجیکٹس پر رابطے کے لیے بیدار ہوں جن کی پیش رفت پرانی ہو۔ حتمی حالت والے (done/paused/archived) پروجیکٹس کی نگرانی کبھی نہیں۔"	OLD="ان پروجیکٹس پر رابطے کے لیے بیدار ہوں جن کی پیش رفت پرانی ہو۔ مکمل (done/paused/archived) پروجیکٹس کی نگرانی کبھی نہیں۔"
wire.settings.wakes_triggers_project_staleness_enabled.label	ROLE=direct_neighbor	EN="Project staleness trigger"	UR="پروجیکٹ کی پرانی پیش رفت کا محرک"	OLD="پروجیکٹ کی پرانی پیش رفت کا محرک"	NEIGHBOR_REASON=Direct label neighbor for the settled-state trigger help.
