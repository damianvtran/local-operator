wire.settings.web_fetch_render_backend.choice.stdlib.description	EN="always the bundled renderer"	UR="ہمیشہ ساتھ دیا گیا رینڈرر"	OLD="ہمیشہ bundled renderer"
wire.settings.web_fetch_render_backend.help	EN="Auto uses markdownify when the [fetch] extra is installed."	UR="[fetch] extra انسٹال ہو تو auto markdownify استعمال کرتا ہے۔"	OLD="[fetch] extra install ہو تو Auto markdownify استعمال کرتا ہے۔"
