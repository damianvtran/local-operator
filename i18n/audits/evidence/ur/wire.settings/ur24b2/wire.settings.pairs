wire.settings.keymap.description	EN="Keys for starting and resuming conversations. Press enter on a row, then press the key you want."	UR="گفتگو شروع اور دوبارہ کھولنے کی کلیدیں۔ کسی قطار پر enter دبائیں، پھر مطلوبہ کلید دبائیں۔"	OLD="گفتگو شروع اور دوبارہ کھولنے کی keys۔ کسی row پر enter دبائیں، پھر مطلوبہ key دبائیں۔"
wire.settings.keymap.title	EN="Hotkeys"	UR="ہاٹ کیز"	OLD="Hotkeys"
wire.settings.language.help	EN="Interface language. auto follows your operating system, falling back to English."	UR="انٹرفیس کی زبان۔ auto آپ کے آپریٹنگ سسٹم کی پیروی کرتی ہے، ورنہ انگریزی۔"	OLD="Interface کی زبان۔ auto آپ کے operating system کی پیروی کرتی ہے، ورنہ English۔"
wire.settings.librarian.description	EN="The Librarian keeps the global Library organised: her display name, the daily pass, and the pause switch. The Library is long-term and shared by every conversation."	UR="Librarian عالمی Library منظم رکھتی ہے: اس کا ظاہری نام، روزانہ پاس، اور روکنے کا اختیار۔ Library طویل مدت کی ہے اور ہر گفتگو میں مشترک ہے۔"	OLD="Librarian عالمی Library منظم رکھتی ہے: اس کا ظاہری نام، روزانہ pass، اور pause۔ Library طویل مدت کی ہے اور ہر گفتگو میں مشترک ہے۔"
wire.settings.librarian_cadence_at.help	EN="Local wall-clock HH:MM. An invalid value falls back to 03:30 at the next arm."	UR="مقامی HH:MM وقت۔ غلط قیمت اگلی بار مقرر کرنے پر 03:30 ہو جائے گی۔"	OLD="مقامی HH:MM وقت۔ غلط قیمت اگلی بار arm کرنے پر 03:30 ہو جائے گی۔"
wire.settings.librarian_cadence_at.label	EN="Daily pass time"	UR="روزانہ پاس کا وقت"	OLD="روزانہ pass کا وقت"
wire.settings.librarian_cadence_max_extra_per_day.help	EN="How many extra passes she may request per day. 0 disables extra passes."	UR="روزانہ کتنے اضافی پاس کی درخواست کر سکے۔ 0 اضافی پاس بند کرتا ہے۔"	OLD="روزانہ کتنے اضافی passes کی درخواست کر سکے۔ 0 اضافی passes بند کرتا ہے۔"
wire.settings.librarian_cadence_max_extra_per_day.label	EN="Extra passes / day"	UR="اضافی پاس / دن"	OLD="اضافی passes / دن"
wire.settings.librarian_cadence_min_gap_minutes.help	EN="Minimum spacing between her passes; closer requests are refused."	UR="پاسوں کے درمیان کم از کم وقفہ؛ اس سے کم وقفے والی درخواستیں مسترد ہوں گی۔"	OLD="Passes کے درمیان کم از کم وقفہ؛ اس سے کم وقفے والی درخواستیں مسترد ہوں گی۔"
wire.settings.librarian_cadence_paused.help	EN="Pausing removes her scheduled rows; resuming re-arms the next pass. The desktop and /librarian write the same key."	UR="روکنے پر شیڈول شدہ قطاریں ہٹتی ہیں؛ resume اگلا پاس مقرر کرتا ہے۔ ڈیسک ٹاپ اور /librarian ایک ہی کلید لکھتے ہیں۔"	OLD="Pause کرنے سے scheduled rows ہٹتی ہیں؛ resume اگلا pass arm کرتا ہے۔ Desktop اور /librarian ایک ہی key لکھتے ہیں۔"
wire.settings.librarian_cadence_paused.label	EN="Daily pass paused"	UR="روزانہ پاس روکا ہوا"	OLD="روزانہ pass روکا ہوا"
wire.settings.librarian_enabled.help	EN="Read at boot and by /v1/desktop/librarian; a disabled install never creates her session."	UR="بوٹ اور /v1/desktop/librarian پر پڑھی جاتی ہے؛ غیر فعال انسٹال اس کا سیشن نہیں بناتی۔"	OLD="boot اور /v1/desktop/librarian پر پڑھی جاتی ہے؛ غیر فعال install اس کا سیشن نہیں بناتی۔"
wire.settings.librarian_name.help	EN="The name her pinned conversation and every receipt use."	UR="وہ نام جو اس کی پن شدہ گفتگو اور ہر رسید استعمال کرے۔"	OLD="وہ نام جو اس کی pinned گفتگو اور ہر receipt استعمال کرے۔"
wire.settings.local_providers.base_url.help	EN="HTTP(S) API root. Changing servers requires a new token through /login; existing tokens are never forwarded to another endpoint."	UR="HTTP(S) API روٹ۔ سرور بدلنے پر /login سے نیا ٹوکن درکار ہے؛ موجودہ ٹوکنز کبھی دوسرے ہوسٹ کو فارورڈ نہیں ہوتے۔"	OLD="HTTP(S) API root۔ Server بدلنے پر /login سے نیا token درکار ہے؛ موجودہ tokens کبھی دوسرے host کو forward نہیں ہوتے۔"
wire.settings.local_providers.base_url.label	EN="{name} endpoint"	UR="{name} بیس URL"	OLD="{name} base URL"
wire.settings.local_providers.description	EN="Server endpoints and exact-model metadata. Use /login to connect; reselect with /model saved to apply model changes."	UR="سرور اینڈ پوائنٹس اور عین ماڈل میٹا ڈیٹا۔ /login سے کنیکٹ کریں؛ ماڈل تبدیلیوں کے لیے /model saved سے دوبارہ منتخب کریں۔"	OLD="Server endpoints اور exact-model metadata۔ /login سے connect کریں؛ ماڈل تبدیلیوں کے لیے /model saved سے دوبارہ منتخب کریں۔"
wire.settings.local_providers.models.help	EN="JSON: '{'\"model-id\":'{'\"context_window\":8192'}''}'; server limits still apply."	UR="JSON: '{'\"model-id\":'{'\"context_window\":8192'}''}'; سرور کی حدود لاگو رہتی ہیں۔"	OLD="JSON: '{'\"model-id\":'{'\"context_window\":8192'}''}'; server کی حدود لاگو رہتی ہیں۔"
wire.settings.local_providers.models.label	EN="{name} model overrides"	UR="{name} ماڈل اووررائیڈس"	OLD="{name} ماڈل overrides"
wire.settings.local_providers.title	EN="Local servers"	UR="مقامی سرورز"	OLD="Local servers"
wire.settings.max_learnings_history.help	EN="Deprecated. Superseded by the compaction engine."	UR="فرسودہ۔ کمپریشن انجن نے بدل دیا ہے۔"	OLD="فرسودہ۔ کمپریشن engine نے بدل دیا ہے۔"
wire.settings.max_learnings_history.label	EN="Max learnings history"	UR="سیکھے ہوئے نکات کی زیادہ سے زیادہ تاریخچہ"	OLD="زیادہ سے زیادہ learnings history"
wire.settings.memory_guard.description	EN="A per-command RAM ceiling, so one oversized command is killed instead of taking the whole device down."	UR="فی کمانڈ RAM حد، تاکہ ایک بڑی کمانڈ ختم ہو، پوری ڈیوائس بند نہ ہو۔"	OLD="فی command RAM حد، تاکہ ایک بڑی command ختم ہو، پوری ڈیوائس بند نہ ہو۔"
wire.settings.memory_guard.title	EN="Command memory limit"	UR="کمانڈ میموری حد"	OLD="Command میموری حد"
wire.settings.mesh_updates.description	EN="The roll that follows a local update: after `lop update` moves this device to a newer build, every other active member is asked to move to the same build — one at a time, each waiting for that member to go idle, never forced. A member that has not granted this device `update` is skipped, by name, with the remedy. Takes effect at once: the next update uses the new setting, and a roll already running stops before its next member — an install already begun finishes."	UR="مقامی اپ ڈیٹ کے بعد رول: `lop update` سے یہ ڈیوائس نئے بلڈ پر جائے تو باقی ہر فعال ممبر سے وہی بلڈ لینے کو کہا جائے — ایک ایک کر کے، ہر ممبر کے بے کار ہونے کا انتظار، کبھی جبر نہیں۔ جس ممبر نے اس ڈیوائس کو `update` کی اجازت نہیں دی اسے نام اور علاج کے ساتھ نظر انداز کیا جائے گا۔ فوراً لاگو: اگلا اپ ڈیٹ نئی ترتیب استعمال کرے گا، جاری رول اگلے ممبر سے پہلے رک جائے گا — شروع شدہ انسٹال مکمل ہوگا۔"	OLD="Local update کے بعد roll: `lop update` سے یہ ڈیوائس نئے build پر جائے تو باقی ہر فعال member سے وہی build لینے کو کہا جائے — ایک ایک کر کے، ہر member کے idle ہونے کا انتظار، کبھی جبر نہیں۔ جس member نے اس ڈیوائس کو `update` نہیں دیا وہ نام اور علاج کے ساتھ skip ہوگا۔ فوراً لاگو: اگلا update نئی ترتیب استعمال کرے گا، جاری roll اگلے member سے پہلے رک جائے گا — شروع شدہ install مکمل ہوگا۔"
wire.settings.mesh_updates.title	EN="Mesh updates"	UR="میش اپ ڈیٹس"	OLD="Mesh updates"
wire.settings.model.description	EN="Provider, model and reasoning effort for new conversations. Existing sessions keep their model; /model saved adopts the default here."	UR="نئی گفتگوؤں کا پرووائیڈر، ماڈل اور استدلال شدت۔ موجودہ سیشنز اپنا ماڈل رکھتے ہیں؛ /model saved یہاں ڈیفالٹ اپناتا ہے۔"	OLD="نئی گفتگوؤں کا provider، ماڈل اور reasoning effort۔ موجودہ سیشنز اپنا ماڈل رکھتے ہیں؛ /model saved یہاں default اپناتا ہے۔"
wire.settings.model_effort.choice.high.description	EN="deep reasoning"	UR="گہرا استدلال"	OLD="گہری reasoning"
wire.settings.model_effort.choice.low.description	EN="light reasoning"	UR="ہلکا استدلال"	OLD="ہلکی reasoning"
wire.settings.model_effort.choice.max.description	EN="the model's deepest reasoning"	UR="ماڈل کا سب سے گہرا استدلال"	OLD="ماڈل کی سب سے گہری reasoning"
wire.settings.model_effort.choice.medium.description	EN="moderate reasoning"	UR="معتدل استدلال"	OLD="معتدل reasoning"
wire.settings.model_effort.choice.minimal.description	EN="the least reasoning the model offers"	UR="ماڈل کی کم از کم استدلالی شدت"	OLD="ماڈل کی کم از کم reasoning"
wire.settings.model_effort.choice.none.description	EN="reasoning off"	UR="استدلال بند"	OLD="reasoning بند"
wire.settings.model_effort.choice.unset.description	EN="the model's own default"	UR="ماڈل کا اپنا ڈیفالٹ"	OLD="ماڈل کا اپنا default"
wire.settings.model_effort.choice.xhigh.description	EN="very deep reasoning"	UR="بہت گہرا استدلال"	OLD="بہت گہری reasoning"
wire.settings.model_effort.help	EN="Effort for new conversations. Unset: the model's default."	UR="نئی گفتگوؤں کے لیے استدلال کی شدت۔ غیر مقرر: ماڈل کا ڈیفالٹ۔"	OLD="نئی گفتگوؤں کا effort۔ Unset: ماڈل کا default۔"
wire.settings.model_effort.label	EN="Default reasoning effort"	UR="ڈیفالٹ استدلال کی شدت"	OLD="Default reasoning effort"
wire.settings.model_name.label	EN="Default model"	UR="ڈیفالٹ ماڈل"	OLD="Default ماڈل"
wire.settings.monitor.description	EN="Delta-watching monitors: how often they check, how much they keep, and when they give up."	UR="تبدیلیوں کی نگرانی: کتنی بار جانچ ہو، کتنا مواد رکھا جائے، اور کب کوشش ختم ہو۔"	OLD="Delta دیکھنے والے نگرانی: کتنی بار check کریں، کتنا رکھیں، اور کب ہار مانیں۔"
wire.settings.monitor_classifymaxchars.help	EN="Bound on the changed lines the materiality check receives (the monitor's name and purpose ride along, clipped separately)."	UR="اہمیت کی جانچ کو بھیجی جانے والی بدلی سطروں کی حد (نگرانی کا نام اور مقصد الگ سے مختصر کر کے ساتھ جاتے ہیں)۔"	OLD="Materiality check کو ملنے والی بدلی lines کی حد (نگرانی کا نام اور مقصد الگ clip ہو کر ساتھ جاتے ہیں)۔"
wire.settings.monitor_classifymaxchars.label	EN="Classifier state (chars)"	UR="کلاسیفائر حالت (حروف)"	OLD="Classifier state (chars)"
wire.settings.monitor_defaultintervals.help	EN="Checks every N seconds when 'every' is omitted; floor 30s."	UR="'every' نہ ہو تو ہر N سیکنڈ بعد جانچ؛ کم از کم 30s۔"	OLD="'every' نہ ہو تو ہر N سیکنڈ بعد check؛ کم از کم 30s۔"
wire.settings.monitor_defaultintervals.label	EN="Default interval (s)"	UR="ڈیفالٹ وقفہ (s)"	OLD="Default وقفہ (s)"
wire.settings.monitor_deltamaxchars.help	EN="Total delta text per delivery message."	UR="ہر ڈیلیوری پیغام میں ڈیلٹا متن کی کل مقدار۔"	OLD="فی delivery پیغام کل delta text۔"
wire.settings.monitor_deltamaxchars.label	EN="Delta budget (chars)"	UR="ڈیلٹا بجٹ (حروف)"	OLD="Delta budget (chars)"
wire.settings.monitor_maxconsecutivefailures.help	EN="Consecutive check failures before a monitor is disabled."	UR="نگرانی بند ہونے سے پہلے لگاتار ناکام جانچیں۔"	OLD="نگرانی بند ہونے سے پہلے لگاتار ناکام checks۔"
wire.settings.monitor_maxdeliveriesperhour.label	EN="Deliveries per hour"	UR="فی گھنٹہ ڈیلیوریز"	OLD="فی گھنٹہ deliveries"
wire.settings.monitor_maxdeltalines.help	EN="Changed lines summarised per delivery."	UR="فی ڈیلیوری خلاصہ شدہ بدلی سطریں۔"	OLD="فی delivery خلاصہ شدہ بدلی lines۔"
wire.settings.monitor_maxdeltalines.label	EN="Max delta lines"	UR="زیادہ سے زیادہ ڈیلٹا سطریں"	OLD="زیادہ سے زیادہ delta lines"
wire.settings.monitor_maxmonitors.help	EN="Refuses arms past N; cancel one first."	UR="N سے زیادہ نگرانیاں مقرر نہیں کی جا سکتیں؛ پہلے ایک منسوخ کریں۔"	OLD="N سے زیادہ arms مسترد؛ پہلے ایک منسوخ کریں۔"
wire.settings.monitor_normalizetimestamps.choice.false.description	EN="timestamps diff like any text"	UR="ٹائم اسٹیمپس عام متن کی طرح ڈف ہوں"	OLD="Timestamps عام text کی طرح diff ہوں"
wire.settings.monitor_normalizetimestamps.choice.true.description	EN="timestamps do not count as changes"	UR="ٹائم اسٹیمپس تبدیلی نہ شمار ہوں"	OLD="Timestamps تبدیلی نہ شمار ہوں"
wire.settings.monitor_normalizetimestamps.help	EN="Treat timestamps as noise before diffing, so clock fields do not alarm."	UR="ڈف کرنے سے پہلے ٹائم اسٹیمپس کو شور سمجھیں تاکہ گھڑی کے فیلڈز الرٹ نہ دیں۔"	OLD="Diff سے پہلے timestamps کو شور سمجھیں تاکہ clock fields alert نہ دیں۔"
wire.settings.monitor_normalizetimestamps.label	EN="Ignore timestamp churn"	UR="ٹائم اسٹیمپ تبدیلیاں نظر انداز"	OLD="Timestamp تبدیلیاں نظر انداز"
wire.settings.monitor_runtimeoutms.help	EN="Per-check deadline; 0 uses 120000 ms."	UR="فی جانچ مہلت؛ 0 پر 120000 ms۔"	OLD="فی check مہلت؛ 0 پر 120000 ms۔"
wire.settings.monitor_runtimeoutms.label	EN="Run timeout (ms)"	UR="رن کی مہلت (ms)"	OLD="Run timeout (ms)"
wire.settings.monitor_snapshotmaxchars.help	EN="Stored normalized output; bounds disk and diff input."	UR="محفوظ نارملائزڈ آؤٹ پٹ؛ ڈسک اور ڈف ان پٹ محدود رکھے۔"	OLD="محفوظ normalized output؛ disk اور diff input محدود رکھے۔"
wire.settings.monitor_snapshotmaxchars.label	EN="Snapshot cap (chars)"	UR="سنیپ شاٹ حد (حروف)"	OLD="Snapshot حد (chars)"
wire.settings.network.description	EN="Where this device listens, what it tells peers to dial, and the bounds for `lop network`: audit retention, how many unauthenticated connections the relay will hold at once, session-copy cadence and how long a borrowed login lives. All take effect when the relay restarts."	UR="یہ ڈیوائس کہاں کنکشن قبول کرے، پیرز کو کیا ڈائل بتائے، اور `lop network` کی حدود: آڈٹ ریٹینشن، ریلے ایک وقت میں کتنے غیر تصدیق شدہ کنکشنز رکھے، سیشن کاپیوں کا وقفہ اور عارضی لاگ اِن کی مدت۔ یہ سب ریلے کے دوبارہ شروع ہونے پر لاگو ہوتے ہیں۔"	OLD="یہ ڈیوائس کہاں listen کرے، peers کو کیا dial بتائے، اور `lop network` کی حدود: audit retention، relay ایک وقت میں کتنے غیر authenticated connections رکھے، سیشن copies کا وقفہ اور borrowed login کی مدت۔ سب relay restart پر لاگو ہوتے ہیں۔"
wire.settings.network.title	EN="Mesh network"	UR="میش نیٹ ورک"	OLD="Mesh network"
wire.settings.network_advertise_hosts.help	EN="Empty = detected. Others: host:port, e.g. 203.0.113.7:4097"	UR="خالی = خودکار شناخت۔ دیگر: host:port، مثلاً 203.0.113.7:4097"	OLD="خالی = detected۔ دیگر: host:port، مثلاً 203.0.113.7:4097"
wire.settings.network_advertise_hosts.label	EN="Advertised endpoints"	UR="اعلان شدہ اینڈ پوائنٹس"	OLD="Advertised endpoints"
wire.settings.network_audit_generations.help	EN="Rotated files kept before the oldest is pruned and that pruning is recorded."	UR="سب سے پرانی فائل حذف ہونے اور اس حذف کے ریکارڈ سے پہلے کتنی گردش شدہ فائلیں رکھی جائیں۔"	OLD="سب سے پرانی prune ہونے اور اس prune کے record سے پہلے کتنی rotated files رکھی جائیں۔"
wire.settings.network_audit_generations.label	EN="Audit generations kept"	UR="محفوظ آڈٹ جنیریشنز"	OLD="محفوظ audit generations"
wire.settings.network_audit_max_age_days.help	EN="Age and size both rotate, because age binds on a quiet install and size on a busy one. Export with `lop network log --export` before pruning."	UR="عمر اور سائز دونوں گردش کرتے ہیں، کیونکہ خاموش انسٹال پر عمر اور مصروف پر سائز لاگو ہوتی ہے۔ حذف سے پہلے `lop network log --export` سے ایکسپورٹ کریں۔"	OLD="عمر اور size دونوں rotate کرتے ہیں، کیونکہ خاموش install پر عمر اور مصروف پر size لاگو ہوتی ہے۔ Prune سے پہلے `lop network log --export` سے export کریں۔"
wire.settings.network_audit_max_age_days.label	EN="Audit age cap (days)"	UR="آڈٹ عمر حد (دن)"	OLD="Audit عمر حد (دن)"
wire.settings.network_audit_max_bytes.help	EN="Bytes per generation, after rotation. 8 MiB of gzipped JSONL is roughly 55k records; the five-generation ceiling is therefore ~40 MiB."	UR="گردش کے بعد فی جنیریشن bytes۔ 8 MiB gzip شدہ JSONL میں تقریباً 55k ریکارڈز ہوتے ہیں؛ پانچ جنیریشنز کی حد اس لیے ~40 MiB ہے۔"	OLD="Rotation کے بعد فی generation bytes۔ 8 MiB gzipped JSONL تقریباً 55k records ہے؛ پانچ generations کی حد اس لیے ~40 MiB۔"
wire.settings.network_audit_max_bytes.label	EN="Audit size per generation"	UR="فی جنیریشن آڈٹ سائز"	OLD="فی generation audit size"
wire.settings.network_credentials_github_repositories.help	EN="owner/repo entries a brokered GitHub token may touch (empty: none)"	UR="بروکر شدہ GitHub ٹوکن کن owner/repo اندراجات تک رسائی رکھے (خالی: کوئی نہیں)"	OLD="Brokered GitHub token کن owner/repo entries تک رسائی رکھے (خالی: کوئی نہیں)"
wire.settings.network_credentials_github_repositories.label	EN="GitHub repositories"	UR="GitHub ریپوزیٹریز"	OLD="GitHub repositories"
wire.settings.network_credentials_grant_ttl_s.help	EN="The longest a device may use a login it borrowed from its owner before asking again, and so how long a revoked or offline owner's login keeps working elsewhere. Never longer than the token itself."	UR="ڈیوائس مالک سے لیا لاگ اِن دوبارہ پوچھنے سے پہلے زیادہ سے زیادہ کتنی دیر استعمال کرے؛ اس سے منسوخ یا آف لائن مالک کا لاگ اِن کہیں اور کتنی دیر چلے۔ ٹوکن سے زیادہ کبھی نہیں۔"	OLD="ڈیوائس owner سے لیا login دوبارہ پوچھنے سے پہلے زیادہ سے زیادہ کتنی دیر استعمال کرے؛ اس سے revoked یا offline owner کا login کہیں اور کتنی دیر چلے۔ Token سے زیادہ کبھی نہیں۔"
wire.settings.network_credentials_grant_ttl_s.label	EN="Borrowed login lifetime (s)"	UR="عارضی لاگ اِن مدت (s)"	OLD="Borrowed login مدت (s)"
wire.settings.network_listen_address.help	EN="127.0.0.1 = dial-only; 0.0.0.0 = all; or one address."	UR="127.0.0.1 = صرف ڈائل؛ 0.0.0.0 = سب؛ یا ایک ایڈریس۔"	OLD="127.0.0.1 = صرف dial؛ 0.0.0.0 = سب؛ یا ایک address۔"
wire.settings.network_listen_address.label	EN="Listen address"	UR="کنکشن قبول کرنے کا ایڈریس"	OLD="Listen address"
wire.settings.network_max_handshakes.help	EN="Unauthenticated connections this relay will hold at once. A pairing holds one for the seconds until the code is typed; anything past the cap is dropped at accept, with no reply frame."	UR="غیر تصدیق شدہ کنکشنز جو ریلے ایک وقت میں رکھے۔ پیئرنگ کوڈ لکھنے کے سیکنڈز تک ایک رکھتی ہے؛ حد سے زیادہ کنکشن قبول کے وقت بغیر جوابی فریم کے حذف ہوتا ہے۔"	OLD="غیر authenticated connections جو relay ایک وقت میں رکھے۔ Pairing code لکھنے کے سیکنڈز تک ایک رکھتی ہے؛ حد سے زیادہ accept پر بغیر reply frame کے drop ہوتا ہے۔"
wire.settings.network_max_handshakes.label	EN="Concurrent handshakes"	UR="ہم وقت ہینڈ شیکس"	OLD="Concurrent handshakes"
wire.settings.network_port.help	EN="The port peers dial; endpoints without one use it."	UR="وہ پورٹ جو پیرز ڈائل کریں؛ بغیر پورٹ والے اینڈ پوائنٹس یہی استعمال کریں۔"	OLD="وہ port جو peers dial کریں؛ بغیر port والے endpoints یہی استعمال کریں۔"
wire.settings.network_port.label	EN="Mesh port"	UR="میش پورٹ"	OLD="Mesh port"
wire.settings.network_rollout_on_update.choice.auto.description	EN="roll when an update moves to a newer build"	UR="اپ ڈیٹ نئے بلڈ پر جائے تو رول کریں"	OLD="Update نئے build پر جائے تو roll کریں"
wire.settings.network_rollout_on_update.choice.off.description	EN="only `lop network update` rolls"	UR="صرف `lop network update` رول کرے"	OLD="صرف `lop network update` roll کرے"
wire.settings.network_rollout_on_update.help	EN="After `lop update` installs a newer build here, ask this device's mesh members to move to it: one at a time, each waiting for idle, never forced. Off: only `lop network update` rolls. A member that has not granted this device `update` is skipped, with the remedy to grant it there."	UR="`lop update` سے یہاں نیا بلڈ آئے تو اس ڈیوائس کے میش ممبرز سے اس پر جانے کو کہیں: ایک ایک کر کے، بے کار ہونے کا انتظار، کبھی جبر نہیں۔ آف: صرف `lop network update` رول کرے۔ جس ممبر نے `update` کی اجازت نہیں دی اسے نظر انداز کر کے وہاں اجازت دینے کا علاج بتایا جائے گا۔"	OLD="`lop update` سے یہاں نیا build آئے تو اس ڈیوائس کے mesh members سے اس پر جانے کو کہیں: ایک ایک کر کے، idle ہونے کا انتظار، کبھی جبر نہیں۔ آف: صرف `lop network update` roll کرے۔ جس member نے `update` نہیں دیا وہ skip ہوگا اور وہیں دینے کا علاج بتایا جائے گا۔"
wire.settings.network_rollout_on_update.label	EN="Roll the mesh after an update"	UR="اپ ڈیٹ کے بعد میش رول کریں"	OLD="Update کے بعد mesh roll کریں"
wire.settings.network_sync_debounce_s.help	EN="Seconds a session's transcript must stay unchanged before its owner tells devices holding a copy to pull. A session going idle pushes at once, so its final message is never held back by this."	UR="مالک، نقل رکھنے والی ڈیوائسز کو pull کہنے سے پہلے سیشن ٹرانسکرپٹ کتنے سیکنڈ غیر بدلا رہے۔ بے کار ہوتے ہی push فوراً ہوتا ہے، اس لیے آخری پیغام اس سے نہیں رکتا۔"	OLD="Owner، copy رکھنے والی devices کو pull کہنے سے پہلے سیشن ٹرانسکرپٹ کتنے سیکنڈ غیر بدلا رہے۔ Idle ہوتے ہی push فوراً ہوتا ہے، اس لیے آخری پیغام اس سے نہیں رکتا۔"
wire.settings.network_sync_debounce_s.label	EN="Sync quiet period (s)"	UR="سنک خاموش مدت (s)"	OLD="Sync خاموش مدت (s)"
wire.settings.network_sync_tick_s.help	EN="How often the owner checks copied sessions for changes: one file stat each."	UR="مالک نقل شدہ سیشنز میں تبدیلی کتنی بار جانچ کرے: ہر بار ایک فائل stat۔"	OLD="Owner copied سیشنز میں تبدیلی کتنی بار check کرے: ہر بار ایک file stat۔"
wire.settings.network_sync_tick_s.label	EN="Sync check interval (s)"	UR="سنک جانچ وقفہ (s)"	OLD="Sync check وقفہ (s)"
wire.settings.openrouter.description	EN="How OpenRouter picks a host; unset = sticky routing."	UR="OpenRouter ہوسٹ کیسے منتخب کرے؛ unset = اسٹکی روٹنگ۔"	OLD="OpenRouter host کیسے منتخب کرے؛ unset = sticky routing۔"
wire.settings.openrouter.title	EN="OpenRouter routing"	UR="OpenRouter روٹنگ"	OLD="OpenRouter routing"
wire.settings.proactive.description	EN="Bounds for the proactive agent class: how long a hidden patience wait defaults to, how it backs off across re-attempts, and when a cycle must end. Read at the moment a wait is armed or fires."	UR="پیش قدم ایجنٹ قسم کی حدود: پوشیدہ انتظار کی ڈیفالٹ مدت، دوبارہ کوششوں میں بیک آف، اور چکر کب ختم ہو۔ یہ انتظار مقرر یا متحرک ہونے پر پڑھی جاتی ہیں۔"	OLD="Proactive ایجنٹ class کی حدود: hidden patience wait کا default، دوبارہ کوششوں میں backoff، اور cycle کب ختم ہو۔ Wait arm یا fire ہونے پر پڑھی جاتی ہے۔"
wire.settings.proactive.title	EN="Proactive class"	UR="پیش قدم قسم"	OLD="Proactive class"
wire.settings.proactive_patience_backoff.help	EN="Each later wait in a cycle is at least this many times the first — the default 5/15/45-minute progression."	UR="چکر میں ہر اگلا انتظار پہلے کا کم از کم اتنا گنا — ڈیفالٹ 5/15/45 منٹ کا سلسلہ۔"	OLD="Cycle میں ہر اگلا wait پہلے کا کم از کم اتنا گنا — default 5/15/45 منٹ کا سلسلہ۔"
wire.settings.proactive_patience_backoff.label	EN="Patience backoff factor"	UR="صبر کے بیک آف کا عنصر"	OLD="Patience backoff factor"
wire.settings.proactive_patience_default_ms.help	EN="How long a hidden wait defaults to when the agent does not size one (milliseconds; 300000 = 5 min). Clamped 60 s..24 h."	UR="ایجنٹ انتظار کی مدت نہ بتائے تو پوشیدہ انتظار کتنی دیر ہو (ملی سیکنڈ؛ 300000 = 5 منٹ)۔ 60 s..24 h تک محدود۔"	OLD="ایجنٹ wait کی مدت نہ بتائے تو hidden wait کتنی دیر ہو (milliseconds؛ 300000 = 5 min)۔ 60 s..24 h تک clamp۔"
wire.settings.proactive_patience_default_ms.label	EN="Default patience wait (ms)"	UR="ڈیفالٹ صبر انتظار (ms)"	OLD="Default patience wait (ms)"
wire.settings.proactive_patience_episode_ttl_ms.help	EN="Hard stop for one cycle however the waits were sized (milliseconds; 7200000 = 2 h). A fire past it retires silently."	UR="انتظار کیسے بھی مقرر ہوں، ایک چکر کی سخت حد (ملی سیکنڈ؛ 7200000 = 2 گھنٹے)۔ اس کے بعد متحرک ہونے والا انتظار خاموشی سے ختم ہو جاتا ہے۔"	OLD="Waits کیسے بھی ہوں، ایک cycle کی سخت حد (milliseconds؛ 7200000 = 2 h)۔ اس کے بعد fire خاموشی سے retire ہوتا ہے۔"
wire.settings.proactive_patience_episode_ttl_ms.label	EN="Patience cycle TTL (ms)"	UR="صبر کے چکر کی TTL (ms)"	OLD="Patience cycle TTL (ms)"
wire.settings.proactive_patience_max_attempts.help	EN="How many outbound waits one cycle may hold before it must end."	UR="ختم ہونے سے پہلے ایک چکر میں کتنے بیرونی انتظار ہو سکتے ہیں۔"	OLD="ختم ہونے سے پہلے ایک cycle میں کتنے outbound waits ہوسکتے ہیں۔"
wire.settings.proactive_patience_max_attempts.label	EN="Patience max attempts"	UR="صبر کی زیادہ سے زیادہ کوششیں"	OLD="Patience زیادہ سے زیادہ attempts"
wire.settings.proactive_patience_max_pending.help	EN="How many hidden waits may be pending at once for one session."	UR="ایک سیشن کے لیے ایک وقت میں کتنے پوشیدہ انتظار زیر التوا ہوسکتے ہیں۔"	OLD="ایک سیشن کے لیے ایک وقت میں کتنے hidden waits pending ہوسکتے ہیں۔"
wire.settings.proactive_patience_max_pending.label	EN="Pending waits per session"	UR="فی سیشن زیر التوا انتظار"	OLD="فی سیشن pending waits"
wire.settings.projects.description	EN="Project records: how long a tracked project may go without a progress line before it reads stale and is worth a check-in. Read at the next staleness computation."	UR="پروجیکٹ ریکارڈز: نگرانی شدہ پروجیکٹ کتنی دیر بغیر پیش رفت کی سطر رہے تو پرانا قرار دے اور رابطہ مفید ہو۔ اگلے پرانے پن کے حساب پر پڑھی جاتی ہے۔"	OLD="پروجیکٹ records: tracked پروجیکٹ کتنی دیر بغیر progress line رہے تو stale قرار دے اور check-in مفید ہو۔ اگلے staleness حساب پر پڑھی جاتی ہے۔"
wire.settings.projects_stale_after_hours.help	EN="A project whose progress is older than this reads stale and is worth a check-in. 1–168 hours."	UR="اس سے پرانی پیش رفت والا پروجیکٹ پرانا ہوگا اور رابطہ مفید۔ 1–168 گھنٹے۔"	OLD="اس سے پرانی progress والا پروجیکٹ stale ہوگا اور check-in مفید۔ 1–168 گھنٹے۔"
wire.settings.projects_stale_after_hours.label	EN="Stale after (hours)"	UR="پرانا ہونے کی حد (گھنٹے)"	OLD="Stale ہونے کا وقت (گھنٹے)"
wire.settings.providers.description	EN="How direct provider connections are made: API surface and cache TTL."	UR="براہ راست پرووائیڈر کنکشنز کیسے بنتے ہیں: API سرفیس اور کیشے TTL۔"	OLD="Direct provider connections کیسے بنیں: API surface اور cache TTL۔"
wire.settings.providers.title	EN="Wire protocol"	UR="Wire پروٹوکول"	OLD="Wire protocol"
wire.settings.providers_anthropic_cache_ttl_1h_min_context_tokens.help	EN="Context size from which Anthropic requests use the 1-hour prompt-cache TTL (2x write cost, survives idle gaps over 5 minutes). 0 disables."	UR="کس سیاق و سباق کے سائز سے Anthropic درخواستیں 1 گھنٹے کی پرامپٹ کیشے TTL استعمال کریں (لکھنے کی 2x لاگت، 5 منٹ سے زیادہ بے کار وقفے میں بھی برقرار)۔ 0 بند کرتا ہے۔"	OLD="کس context size سے Anthropic requests 1-hour prompt-cache TTL استعمال کریں (2x write cost، 5 منٹ سے زیادہ idle وقفے میں بھی برقرار)۔ 0 بند کرتا ہے۔"
wire.settings.providers_anthropic_cache_ttl_1h_min_context_tokens.label	EN="Anthropic 1h cache above (tokens)"	UR="Anthropic 1h کیشے حد (ٹوکنز)"	OLD="Anthropic 1h cache حد (tokens)"
wire.settings.providers_openai_api.choice.chat_completions.description	EN="explicit compatibility opt-out"	UR="مطابقت سے واضح اختیاری انحراف"	OLD="Explicit compatibility opt-out"
wire.settings.providers_openai_api.choice.responses.description	EN="the public Responses API (default)"	UR="عوامی Responses API (ڈیفالٹ)"	OLD="Public Responses API (default)"
wire.settings.providers_openai_api.help	EN="Direct OpenAI GPT-5 calls use the Responses API unless opted out."	UR="براہ راست OpenAI GPT-5 کالیں، اختیاری انحراف کے بغیر، Responses API استعمال کرتی ہیں۔"	OLD="Direct OpenAI GPT-5 calls، opt-out کے بغیر، Responses API استعمال کرتی ہیں۔"
wire.settings.providers_openai_api.label	EN="OpenAI API surface"	UR="OpenAI API سرفیس"	OLD="OpenAI API surface"
wire.settings.providers_openai_use_max_context_window.help	EN="Off: provider default. On: supported max. Applies next request; compaction unchanged."	UR="آف: پرووائیڈر ڈیفالٹ۔ آن: زیادہ سے زیادہ تعاون یافتہ سیاق و سباق۔ اگلی درخواست پر لاگو؛ کمپریشن نہیں بدلتی۔"	OLD="آف: provider default۔ آن: supported max۔ اگلی request پر لاگو؛ کمپریشن نہیں بدلتی۔"
wire.settings.providers_openai_use_max_context_window.label	EN="Use maximum OpenAI context"	UR="زیادہ سے زیادہ OpenAI سیاق و سباق استعمال کریں"	OLD="زیادہ سے زیادہ OpenAI context استعمال کریں"
wire.settings.providers_openrouter_allow_fallbacks.choice.unset.description	EN="no preference — OpenRouter's default (fall through)"	UR="کوئی ترجیح نہیں — OpenRouter ڈیفالٹ (آگے منتقل)"	OLD="کوئی ترجیح نہیں — OpenRouter default (آگے منتقل)"
wire.settings.providers_openrouter_allow_fallbacks.help	EN="'default' sends nothing (OpenRouter falls through to another host when the preferred one fails); 'false' fails rather than fall through to a host outside your preferences."	UR="'default' کچھ نہیں بھیجتی (ترجیحی ہوسٹ ناکام ہو تو OpenRouter دوسرے ہوسٹ پر منتقل ہوتا ہے)؛ 'false' آپ کی ترجیحات سے باہر ہوسٹ پر جانے کے بجائے ناکام ہوتی ہے۔"	OLD="'default' کچھ نہیں بھیجتی (preferred host ناکام ہو تو OpenRouter دوسرے host پر منتقل ہوتا ہے)؛ 'false' آپ کی ترجیحات سے باہر host پر جانے کے بجائے ناکام ہوتی ہے۔"
wire.settings.providers_openrouter_allow_fallbacks.label	EN="fallbacks"	UR="فال بیکس"	OLD="fallbacks"
wire.settings.providers_openrouter_data_collection.choice.allow.description	EN="hosts may collect data"	UR="ہوسٹس ڈیٹا جمع کر سکتے ہیں"	OLD="hosts data جمع کر سکتے ہیں"
wire.settings.providers_openrouter_data_collection.choice.deny.description	EN="exclude hosts that collect data"	UR="ڈیٹا جمع کرنے والے ہوسٹس نکالیں"	OLD="Data جمع کرنے والے hosts نکالیں"
wire.settings.providers_openrouter_data_collection.help	EN="'deny' excludes hosts that may train on or retain your prompts. 'default' sends no preference (OpenRouter's default: allow)."	UR="'deny' ایسے ہوسٹس نکالتی ہے جو آپ کے پرامپٹس پر تربیت یا انہیں محفوظ کر سکتے ہوں۔ 'default' کوئی ترجیح نہیں بھیجتی (OpenRouter ڈیفالٹ: allow)۔"	OLD="'deny' ایسے hosts نکالتی ہے جو آپ کے prompts پر train یا انہیں retain کر سکتے ہوں۔ 'default' کوئی ترجیح نہیں بھیجتی (OpenRouter default: allow)۔"
wire.settings.providers_openrouter_data_collection.label	EN="data collection"	UR="ڈیٹا جمع کرنا"	OLD="data collection"
wire.settings.providers_openrouter_enforce_distillable_text.choice.true.description	EN="distillable-text endpoints only"	UR="صرف ڈسٹل قابل متن اینڈ پوائنٹس"	OLD="صرف distillable-text endpoints"
wire.settings.providers_openrouter_enforce_distillable_text.help	EN="'true': restrict to endpoints whose text output may be distilled. 'default': nothing sent."	UR="'true': صرف ان اینڈ پوائنٹس تک محدود جن کے متن آؤٹ پٹ کو ڈسٹل کیا جا سکے۔ 'default': کچھ نہیں بھیجا۔"	OLD="'true': صرف ان endpoints تک محدود جن کے text output کو distill کیا جا سکے۔ 'default': کچھ نہیں بھیجا۔"
wire.settings.providers_openrouter_enforce_distillable_text.label	EN="distillable text"	UR="ڈسٹل ہونے والا متن"	OLD="distillable text"
wire.settings.providers_openrouter_ignore.help	EN="Empty = no opinion (sticky routing stays). Comma-separated block-list of host slugs to omit (e.g. a host that is failing right now) — may cost you the warm prompt cache."	UR="خالی = کوئی رائے نہیں (اسٹکی روٹنگ برقرار)۔ نظر انداز کیے جانے والے ہوسٹ سلگز کی کاما سے الگ بلاک لسٹ (مثلاً ابھی ناکام ہوسٹ) — وارم پرامپٹ کیشے ضائع ہو سکتی ہے۔"	OLD="خالی = کوئی رائے نہیں (sticky routing برقرار)۔ نظر انداز کرنے والے host slugs کی comma-separated block-list (مثلاً ابھی ناکام host) — warm prompt cache ضائع ہوسکتی ہے۔"
wire.settings.providers_openrouter_ignore.label	EN="ignored hosts"	UR="نظر انداز ہوسٹس"	OLD="نظر انداز hosts"
wire.settings.providers_openrouter_max_price.help	EN="'{'\"prompt\": 1, \"completion\": 2'}' — USD / million tokens"	UR="'{'\"prompt\": 1, \"completion\": 2'}' — USD / ملین ٹوکنز"	OLD="'{'\"prompt\": 1, \"completion\": 2'}' — USD / ملین tokens"
wire.settings.providers_openrouter_max_price.label	EN="max price"	UR="زیادہ سے زیادہ قیمت"	OLD="max price"
wire.settings.providers_openrouter_only.help	EN="Empty = no opinion (sticky routing stays). Comma-separated allow-list of host slugs; every other host is excluded — a forced cold start if the warm host is not on it."	UR="خالی = کوئی رائے نہیں (اسٹکی روٹنگ برقرار)۔ ہوسٹ سلگز کی کاما سے الگ اجازت کی فہرست؛ باقی ہر ہوسٹ مستثنیٰ — وارم ہوسٹ فہرست میں نہ ہو تو کولڈ آغاز لازم۔"	OLD="خالی = کوئی رائے نہیں (sticky routing برقرار)۔ Host slugs کی comma-separated allow-list؛ باقی ہر host مستثنیٰ — warm host قائم میں نہ ہو تو cold start لازم۔"
wire.settings.providers_openrouter_only.label	EN="allowed hosts"	UR="اجازت یافتہ ہوسٹس"	OLD="اجازت یافتہ hosts"
wire.settings.providers_openrouter_order.help	EN="Empty = no opinion (sticky routing stays). Comma-separated host slugs tried in this exact order."	UR="خالی = کوئی رائے نہیں (اسٹکی روٹنگ برقرار)۔ ہوسٹ سلگز اسی ترتیب میں استعمال کیے جائیں۔"	OLD="خالی = کوئی رائے نہیں (sticky routing برقرار)۔ Host slugs اسی ترتیب میں آزمائے جائیں۔"
wire.settings.providers_openrouter_order.label	EN="host order"	UR="ہوسٹ ترتیب"	OLD="host ترتیب"
wire.settings.providers_openrouter_order.warning	EN="disables sticky routing — prompt cache goes cold"	UR="اسٹکی روٹنگ بند — پرامپٹ کیشے کولڈ ہو جائے گی"	OLD="Sticky routing بند — prompt cache cold ہو جائے گی"
wire.settings.providers_openrouter_preferred_max_latency.help	EN="Prefer hosts whose time-to-first-token stays under this many seconds (p50). 0 sends no preference. A host above the bar is deprioritised, which may cost you a warm prompt cache."	UR="ان ہوسٹس کو ترجیح دیں جن کے پہلے ٹوکن کا وقت اتنے سیکنڈ سے کم ہو (p50)۔ 0 کوئی ترجیح نہیں بھیجتا۔ حد سے اوپر ہوسٹ کم ترجیحی ہوگا، جس سے وارم پرامپٹ کیشے ضائع ہو سکتی ہے۔"	OLD="ان hosts کو ترجیح دیں جن کا time-to-first-token اتنے سیکنڈ سے کم ہو (p50)۔ 0 کوئی ترجیح نہیں بھیجتا۔ حد سے اوپر host کم ترجیحی ہوگا، جس سے warm prompt cache ضائع ہوسکتی ہے۔"
wire.settings.providers_openrouter_preferred_max_latency.label	EN="max latency (s)"	UR="زیادہ سے زیادہ لیٹنسی (s)"	OLD="max latency (s)"
wire.settings.providers_openrouter_preferred_min_throughput.help	EN="Prefer hosts serving at least this many output tokens/sec (p50). 0 sends no preference. A host below the bar is deprioritised, which may cost you a warm prompt cache."	UR="کم از کم اتنے آؤٹ پٹ ٹوکنز/سیکنڈ دینے والے ہوسٹس کو ترجیح دیں (p50)۔ 0 کوئی ترجیح نہیں بھیجتا۔ حد سے نیچے ہوسٹ کم ترجیحی ہوگا، جس سے وارم پرامپٹ کیشے ضائع ہو سکتی ہے۔"	OLD="کم از کم اتنے output tokens/sec دینے والے hosts کو ترجیح دیں (p50)۔ 0 کوئی ترجیح نہیں بھیجتا۔ حد سے نیچے host کم ترجیحی ہوگا، جس سے warm prompt cache ضائع ہوسکتی ہے۔"
wire.settings.providers_openrouter_preferred_min_throughput.label	EN="min throughput (tok/s)"	UR="کم از کم تھراپٹ (tok/s)"	OLD="min throughput (tok/s)"
wire.settings.providers_openrouter_provider_affinity.help	EN="Reuses the host that served the previous turn so the prompt cache stays warm. Off = OpenRouter's price-weighted load balancing."	UR="پچھلے ٹرن والا ہوسٹ دوبارہ استعمال کریں تاکہ پرامپٹ کیشے وارم رہے۔ آف = OpenRouter کی قیمت کے وزن والی لوڈ بیلنسنگ۔"	OLD="پچھلے turn والا host دوبارہ استعمال کریں تاکہ prompt cache warm رہے۔ آف = OpenRouter کا price-weighted load balancing۔"
wire.settings.providers_openrouter_provider_affinity.label	EN="cache affinity"	UR="کیشے وابستگی"	OLD="cache affinity"
wire.settings.providers_openrouter_quantizations.help	EN="Empty = no opinion. Comma-separated quantization levels the served model may use (e.g. int8, fp8, mxfp4)."	UR="خالی = کوئی رائے نہیں۔ پیش شدہ ماڈل کے قابل استعمال کوانٹائزیشن کی سطحیں، کاما سے الگ (مثلاً int8، fp8، mxfp4)۔"	OLD="خالی = کوئی رائے نہیں۔ Served ماڈل کے قابل استعمال quantization levels، comma-separated (مثلاً int8، fp8، mxfp4)۔"
wire.settings.providers_openrouter_quantizations.label	EN="quantizations"	UR="کوانٹائزیشنز"	OLD="quantizations"
wire.settings.providers_openrouter_require_parameters.choice.true.description	EN="only hosts that support every parameter"	UR="صرف وہ ہوسٹس جو ہر پیرامیٹر کی حمایت کریں"	OLD="صرف وہ hosts جو ہر parameter support کریں"
wire.settings.providers_openrouter_require_parameters.choice.unset.description	EN="no preference — unsupported parameters may be dropped"	UR="کوئی ترجیح نہیں — غیر معاون پیرامیٹرز حذف ہوسکتے ہیں"	OLD="کوئی ترجیح نہیں — unsupported parameters drop ہوسکتے ہیں"
wire.settings.providers_openrouter_require_parameters.help	EN="'true' restricts to hosts that support every parameter you send (tools, structured output); 'default' lets OpenRouter silently drop unsupported ones."	UR="'true' صرف ان ہوسٹس تک محدود جو آپ کے بھیجے ہر پیرامیٹر (ٹولز، ساختہ آؤٹ پٹ) کی حمایت کریں؛ 'default' OpenRouter کو غیر معاون پیرامیٹرز خاموشی سے حذف کرنے دیتی ہے۔"	OLD="'true' صرف ان hosts تک محدود جو آپ کے بھیجے ہر parameter (tools، structured output) کی حمایت کریں؛ 'default' OpenRouter کو unsupported parameters خاموشی سے drop کرنے دیتی ہے۔"
wire.settings.providers_openrouter_require_parameters.label	EN="require parameters"	UR="پیرامیٹرز لازم کریں"	OLD="require parameters"
wire.settings.providers_openrouter_sort.choice.latency.description	EN="lowest response latency first"	UR="سب سے کم جوابی لیٹنسی پہلے"	OLD="سب سے کم response latency پہلے"
wire.settings.providers_openrouter_sort.choice.latency.label	EN="latency"	UR="لیٹنسی"	OLD="latency"
