wire.settings.session_cleanup_max_inactive_days.help	EN="Needs cleanup on. Remove sessions idle this many days; 0 = never."	UR="صفائی آن ہو۔ اتنے دن بے کار سیشنز ہٹائیں؛ 0 = کبھی نہیں۔"	OLD="Cleanup آن ہو۔ اتنے دن idle سیشنز ہٹائیں؛ 0 = کبھی نہیں۔"
wire.settings.session_cleanup_max_inactive_days.label	EN="↳ max inactive days"	UR="↳ زیادہ سے زیادہ غیر فعال دن"	OLD="↳ زیادہ سے زیادہ inactive دن"
wire.settings.session_cleanup_max_sessions.help	EN="Needs cleanup on. Keep N newest /resume sessions; 0 = no cap."	UR="صفائی آن ہو۔ N تازہ ترین /resume سیشنز رکھیں؛ 0 = کوئی حد نہیں۔"	OLD="Cleanup آن ہو۔ N newest /resume سیشنز رکھیں؛ 0 = کوئی حد نہیں۔"
wire.settings.session_cleanup_max_total_bytes.help	EN="Needs cleanup on. Trim oldest past this many bytes; 0 = no cap."	UR="صفائی آن ہو۔ اتنے bytes سے بڑھنے پر پرانے ہٹائیں؛ 0 = کوئی حد نہیں۔"	OLD="Cleanup آن ہو۔ اتنے bytes سے بڑھنے پر پرانے ہٹائیں؛ 0 = کوئی حد نہیں۔"
wire.settings.session_cleanup_remove_empty.choice.true.description	EN="remove transcript-less directories"	UR="بغیر ٹرانسکرپٹ والی ڈائریکٹریز ہٹائیں"	OLD="بغیر ٹرانسکرپٹ والی directories ہٹائیں"
wire.settings.session_cleanup_remove_empty.help	EN="Needs cleanup on. Remove dirs that never got a transcript."	UR="صفائی آن ہو۔ وہ ڈائریکٹریز ہٹائیں جن میں کبھی ٹرانسکرپٹ نہ بنا۔"	OLD="Cleanup آن ہو۔ وہ dirs ہٹائیں جن میں کبھی ٹرانسکرپٹ نہ بنا۔"
wire.settings.session_compression.description	EN="History is kept in full; old transcripts are stored compressed and read back automatically. Off: every transcript stays as a plain file."	UR="تاریخچہ مکمل رہتی ہے؛ پرانے ٹرانسکرپٹس کمپریس کر کے محفوظ ہوتے اور خودکار پڑھے جاتے ہیں۔ آف: ہر ٹرانسکرپٹ سادہ فائل رہتا ہے۔"	OLD="History مکمل رہتی ہے؛ پرانے ٹرانسکرپٹس کمپریس محفوظ ہو کر خودکار پڑھے جاتے ہیں۔ آف: ہر ٹرانسکرپٹ سادہ فائل رہتا ہے۔"
wire.settings.session_compression_after_days.help	EN="Needs compression on. Days idle before a transcript is compressed; 1 to 3650. Default 30."	UR="کمپریشن آن ہو۔ ٹرانسکرپٹ کمپریس ہونے سے پہلے بے کار دن؛ 1 تا 3650۔ ڈیفالٹ 30۔"	OLD="Compression آن ہو۔ ٹرانسکرپٹ کمپریس ہونے سے پہلے idle دن؛ 1 تا 3650۔ Default 30۔"
wire.settings.session_compression_enabled.help	EN="Off: transcripts stay plain; compressed sessions stay readable. On: old transcripts compress at launch."	UR="آف: ٹرانسکرپٹس سادہ رہتے ہیں؛ کمپریس شدہ سیشنز پڑھے جا سکتے ہیں۔ آن: پرانے ٹرانسکرپٹس لانچ پر کمپریس ہوتے ہیں۔"	OLD="آف: ٹرانسکرپٹس سادہ رہتے ہیں؛ کمپریس سیشنز پڑھے جاسکتے ہیں۔ آن: پرانے ٹرانسکرپٹس launch پر کمپریس ہوتے ہیں۔"
wire.settings.session_delegated.description	EN="Delegated work: subagent and background-session transcripts and their scratch folders. On by default: they are removed after the age below. Your conversations, sidebar workstreams, anything running, waiting on a wake or monitor, linked to an open project, still in use by an active parent, or holding unpushed or uncommitted git work are kept."	UR="سونپا گیا کام: ذیلی ایجنٹ اور پس منظر سیشنز کے ٹرانسکرپٹس اور ان کے اسکریچ فولڈرز۔ ڈیفالٹ آن: نیچے دی گئی عمر کے بعد ہٹتے ہیں۔ آپ کی گفتگوئیں، سائڈبار ورک اسٹریمز، کوئی چلتی، بیداری یا نگرانی کے منتظر، کھلے پروجیکٹ سے منسلک، فعال پیرنٹ کے استعمال میں، یا push یا commit نہ کیے گئے git کام والی چیزیں محفوظ رہتی ہیں۔"	OLD="Delegated کام: ذیلی ایجنٹ اور background-session ٹرانسکرپٹس اور ان کے scratch folders۔ Default آن: نیچے دی گئی عمر کے بعد ہٹتے ہیں۔ آپ کی گفتگو، sidebar workstreams، چلتی، بیداری یا نگرانی کے منتظر، کھلے پروجیکٹ سے منسلک، فعال parent کے استعمال میں، یا unpushed/uncommitted git کام رکھنے والی چیزیں رہتی ہیں۔"
wire.settings.session_delegated.title	EN="Delegated work"	UR="سونپا گیا کام"	OLD="Delegated کام"
wire.settings.session_scratchpad.description	EN="What one session's own scratch area may hold. The cap is checked on every write and applies immediately."	UR="ایک سیشن کا اپنا اسکریچ علاقہ کتنا رکھ سکے۔ ہر تحریر پر حد جانچ کر فوراً لاگو ہوتی ہے۔"	OLD="ایک سیشن کا اپنا scratch area کتنا رکھ سکے۔ ہر write پر حد check ہو کر فوراً لاگو ہوتی ہے۔"
wire.settings.session_scratchpad_max_bytes.help	EN="Bytes a session's scratchpad may hold: 16 MiB to 8 GiB. Default 256 MiB."	UR="سیشن کے Scratchpad کی گنجائش: 16 MiB تا 8 GiB۔ ڈیفالٹ 256 MiB۔"	OLD="سیشن کے Scratchpad کی گنجائش: 16 MiB تا 8 GiB۔ Default 256 MiB۔"
wire.settings.shell_environment.description	EN="What a command the agent runs can see. Resolved once per session, so an edit here applies at the next launch and cannot weaken a session that is already running."	UR="ایجنٹ کی چلائی کمانڈ کیا دیکھ سکے۔ فی سیشن ایک بار طے ہوتا ہے، اس لیے تبدیلی اگلے لانچ پر لاگو ہوتی ہے اور چلتے سیشن کو کمزور نہیں کر سکتی۔"	OLD="ایجنٹ کی چلائی command کیا دیکھ سکے۔ فی سیشن ایک بار resolve ہوتا ہے، اس لیے تبدیلی اگلے launch پر لاگو ہوتی ہے اور چلتے سیشن کو کمزور نہیں کر سکتی۔"
wire.settings.shell_environment.title	EN="Agent shell"	UR="ایجنٹ شیل"	OLD="ایجنٹ shell"
wire.settings.shell_environment_exclude.help	EN="Empty = nothing removed. Names never handed to a command the agent runs, in either mode — including the session credential store's own injections, so this is how a variable is denied outright. Covers the bash and eval children only; MCP servers and the harness's own processes are not governed by it."	UR="خالی = کچھ نہیں نکلتا۔ وہ نام جو ایجنٹ کمانڈ کو کسی موڈ میں نہیں ملتے — سیشن کریڈینشل اسٹور کی اپنی انجیکشنز بھی — اس لیے ویریئیبل کو مکمل روکنے کا طریقہ یہی ہے۔ صرف bash اور eval ذیلی پروسیسز؛ MCP سرورز اور ہارنس کے اپنے پروسیسز اس کے تابع نہیں۔"	OLD="خالی = کچھ نہیں نکلتا۔ وہ names جو ایجنٹ command کو کسی mode میں نہیں ملتے — session credential store کی اپنی injections بھی — اس لیے variable کو مکمل روکنے کا طریقہ یہی ہے۔ صرف bash اور eval children؛ MCP servers اور harness کے اپنے processes اس کے تابع نہیں۔"
wire.settings.shell_environment_exclude.label	EN="…removed in both modes"	UR="…دونوں موڈز میں نکالے گئے"	OLD="…دونوں modes میں نکالے گئے"
wire.settings.shell_environment_inherit.help	EN="Empty = the safe set alone. Names the allowlist mode keeps ON TOP of the safe set — e.g. LOCAL_OPERATOR_CONFIG_DIR for a shell that must still resolve $(lop secret get NAME), or LANG. Inert in inherit mode."	UR="خالی = صرف محفوظ سیٹ۔ وہ نام جو allowlist موڈ محفوظ سیٹ کے علاوہ رکھے — مثلاً ایسے شیل کے لیے LOCAL_OPERATOR_CONFIG_DIR جسے $(lop secret get NAME) حل کرنا ہو، یا LANG۔ inherit موڈ میں بے اثر۔"	OLD="خالی = صرف safe set۔ وہ names جو allowlist mode safe set کے علاوہ رکھے — مثلاً ایسے shell کے لیے LOCAL_OPERATOR_CONFIG_DIR جسے $(lop secret get NAME) resolve کرنا ہو، یا LANG۔ inherit mode میں بے اثر۔"
wire.settings.shell_environment_inherit.label	EN="…kept in allowlist mode"	UR="…allowlist موڈ میں رکھے گئے"	OLD="…allowlist mode میں رکھے گئے"
wire.settings.shell_environment_mode.choice.allowlist.description	EN="the safe set plus the lists below, nothing else"	UR="محفوظ سیٹ اور نیچے کی فہرستیں، اور کچھ نہیں"	OLD="Safe set اور نیچے کی lists، اور کچھ نہیں"
wire.settings.shell_environment_mode.choice.inherit.description	EN="your environment, as today (default)"	UR="آپ کا ماحول، جیسا آج (ڈیفالٹ)"	OLD="آپ کا environment، جیسا آج (default)"
wire.settings.shell_environment_mode.help	EN="'inherit' lets a command the agent runs see your environment (gh, aws, npm keep their tokens). 'allowlist' passes only PATH/HOME/SHELL/TERM/USER/LOGNAME plus the two lists beside this, so the provider key this session launched with is not handed to a command the model writes. Read once per session: changing it takes effect at the next launch."	UR="'inherit' ایجنٹ کمانڈ کو آپ کا ماحول دیکھنے دیتی ہے (gh، aws، npm اپنے ٹوکنز رکھتے ہیں)۔ 'allowlist' صرف PATH/HOME/SHELL/TERM/USER/LOGNAME اور ساتھ کی دو فہرستیں دیتی ہے، اس لیے سیشن لانچ کی پرووائیڈر کلید ماڈل کی لکھی کمانڈ کو نہیں ملتی۔ فی سیشن ایک بار پڑھی جاتی ہے: تبدیلی اگلے لانچ پر لاگو ہوتی ہے۔"	OLD="'inherit' ایجنٹ command کو آپ کا environment دیکھنے دیتی ہے (gh، aws، npm اپنے tokens رکھتے ہیں)۔ 'allowlist' صرف PATH/HOME/SHELL/TERM/USER/LOGNAME اور ساتھ کی دو lists دیتی ہے، اس لیے سیشن launch کی provider key ماڈل کی لکھی command کو نہیں ملتی۔ فی سیشن ایک بار پڑھی جاتی ہے: تبدیلی اگلے launch پر لاگو ہوتی ہے۔"
wire.settings.shell_environment_mode.label	EN="Agent shell environment"	UR="ایجنٹ شیل ماحول"	OLD="ایجنٹ shell environment"
wire.settings.speech.description	EN="How the assistant sounds when it speaks aloud. The descriptor is sent to the hub, which maps it onto whichever voice provider serves; fields a provider cannot express degrade with a note rather than failing. Read on the next spoken message."	UR="بولنے پر اسسٹنٹ کی آواز کیسی ہو۔ آواز کی تفصیل hub کو جاتی ہے، جو اسے دستیاب آواز پرووائیڈر کے مطابق بناتا ہے؛ پرووائیڈر سے ناقابل اظہار فیلڈز ناکامی کے بجائے نوٹ کے ساتھ کم ہوتی ہیں۔ اگلے بولے پیغام پر پڑھی جاتی ہے۔"	OLD="بولنے پر assistant کی آواز کیسی ہو۔ Descriptor hub کو جاتا ہے، جو voice provider کے مطابق بناتا ہے؛ provider سے ناقابل اظہار fields ناکامی کے بجائے note کے ساتھ کم ہوتی ہیں۔ اگلے بولے پیغام پر پڑھی جاتی ہے۔"
wire.settings.speech.title	EN="Speech voicing"	UR="تقریر کی آواز"	OLD="Speech voicing"
wire.settings.speech_transcription_cleanup.choice.auto.description	EN="Native, else client rules."	UR="مقامی، ورنہ کلائنٹ قواعد۔"	OLD="Native، ورنہ client rules۔"
wire.settings.speech_transcription_cleanup.choice.client.description	EN="Client rules; request raw copy."	UR="کلائنٹ قواعد؛ خام نقل کی درخواست۔"	OLD="Client rules؛ raw copy کی درخواست۔"
wire.settings.speech_transcription_cleanup.choice.off.description	EN="Verbatim; no filler or cue removal."	UR="حرف بہ حرف؛ فلر الفاظ یا غیر گفتار اشارے حذف نہیں۔"	OLD="حرف بہ حرف؛ filler یا cue removal نہیں۔"
wire.settings.speech_transcription_cleanup.choice.provider.description	EN="Native only where offered."	UR="صرف جہاں مقامی صفائی دستیاب ہو۔"	OLD="صرف جہاں native دستیاب ہو۔"
wire.settings.speech_transcription_cleanup.help	EN="How dictation strips filler words and non-speech cues. auto uses the provider's native cleanup where available and the conservative client rules elsewhere; provider and client each use only one of the two mechanisms; off keeps the verbatim transcript. A per-request `cleanup` field still wins."	UR="املاء سے فلر الفاظ اور غیر گفتار اشارے کیسے نکلیں۔ auto جہاں ممکن ہو پرووائیڈر کی مقامی صفائی، ورنہ محتاط کلائنٹ قواعد استعمال کرتا ہے؛ provider اور client میں سے ہر ایک صرف ایک میکانیزم استعمال کرتا ہے؛ آف حرف بہ حرف ٹرانسکرپٹ رکھتا ہے۔ فی درخواست `cleanup` فیلڈ بھی اول ہے۔"	OLD="Dictation سے filler words اور غیر speech cues کیسے نکلیں۔ auto جہاں ممکن ہو provider native cleanup، ورنہ conservative client rules استعمال کرتا ہے؛ provider اور client میں سے ہر ایک صرف ایک mechanism استعمال کرتا ہے؛ آف verbatim ٹرانسکرپٹ رکھتا ہے۔ فی-request `cleanup` field بھی اول ہے۔"
wire.settings.speech_transcription_cleanup.label	EN="Transcription cleanup"	UR="ٹرانسکرپٹ کی صفائی"	OLD="ٹرانسکرپٹion cleanup"
wire.settings.speech_voice_accent.help	EN="A region tag such as en-GB, or empty. Reaches the provider as instructions text."	UR="مثلاً en-GB جیسا علاقائی ٹیگ، یا خالی۔ پرووائیڈر کو ہدایات کے متن میں جاتا ہے۔"	OLD="مثلاً en-GB جیسا region tag، یا خالی۔ Provider کو instructions text میں جاتا ہے۔"
wire.settings.speech_voice_expressiveness.choice.high.description	EN="Lively and expressive."	UR="جاندار اور اظہار آمیز۔"	OLD="زندہ دل اور expressive۔"
wire.settings.speech_voice_expressiveness.choice.medium.description	EN="Today's constant."	UR="موجودہ مستقل قیمت۔"	OLD="آج کی مستقل قیمت۔"
wire.settings.speech_voice_expressiveness.help	EN="How animated the delivery is. Sets ElevenLabs stability; a phrase on OpenAI."	UR="ڈیلیوری کتنی جاندار ہو۔ ElevenLabs کا استحکام مقرر کرے؛ OpenAI پر ایک جملہ۔"	OLD="Delivery کتنی animated ہو۔ ElevenLabs stability مقرر کرے؛ OpenAI پر ایک phrase۔"
wire.settings.speech_voice_expressiveness.label	EN="Expressiveness"	UR="اظہاریت"	OLD="Expressiveness"
wire.settings.speech_voice_gender.choice.auto.description	EN="Classify per agent (recommended)."	UR="ہر ایجنٹ کے لیے درجہ بندی (تجویز کردہ)۔"	OLD="فی ایجنٹ classify کریں (تجویز کردہ)۔"
wire.settings.speech_voice_gender.choice.female.description	EN="Always use a female voice."	UR="ہمیشہ نسوانی آواز استعمال کریں۔"	OLD="ہمیشہ female voice استعمال کریں۔"
wire.settings.speech_voice_gender.choice.male.description	EN="Always use a male voice."	UR="ہمیشہ مردانہ آواز استعمال کریں۔"	OLD="ہمیشہ male voice استعمال کریں۔"
wire.settings.speech_voice_gender.help	EN="auto picks per agent; a fixed value overrides the classifier."	UR="auto ہر ایجنٹ کے لیے منتخب کرتی ہے؛ مقررہ قیمت کلاسیفائر کو اووررائیڈ کرتی ہے۔"	OLD="auto فی ایجنٹ منتخب کرتی ہے؛ مقررہ قیمت classifier کو override کرتی ہے۔"
wire.settings.speech_voice_gender.label	EN="Voice gender"	UR="آواز کی جنس"	OLD="Voice gender"
wire.settings.speech_voice_instructions.help	EN="Free text for how speech should sound (OpenAI only). Empty sends none of our own."	UR="آواز کی ڈیلیوری کے لیے آزاد متن (صرف OpenAI)۔ خالی ہونے پر ہماری طرف سے کوئی ہدایت نہیں جاتی۔"	OLD="آواز کیسی ہو، free text (صرف OpenAI)۔ خالی پر ہماری کوئی نہیں جاتی۔"
wire.settings.speech_voice_instructions.label	EN="Delivery instructions"	UR="ڈیلیوری کی ہدایات"	OLD="Delivery instructions"
wire.settings.speech_voice_language.help	EN="auto lets the provider detect; a two-letter code (e.g. es) pins it."	UR="auto پرووائیڈر کو شناخت کرنے دیتی ہے؛ دو حرفی کوڈ (مثلاً es) مقرر کرتی ہے۔"	OLD="auto provider کو detect کرنے دیتی ہے؛ دو حرفی code (مثلاً es) مقرر کرتی ہے۔"
wire.settings.speech_voice_pace.help	EN="Speaking rate, 1.0 being normal. A provider whose own range is narrower clamps."	UR="بولنے کی رفتار، 1.0 معمول۔ پرووائیڈر کی تنگ حد ہو تو اسی کے مطابق ڈھال دے گا۔"	OLD="بولنے کی رفتار، 1.0 معمول۔ Provider کی تنگ range ہو تو clamp کرے گا۔"
wire.settings.speech_voice_tone.choice.warm.label	EN="warm"	UR="وارم"	OLD="warm"
wire.settings.speech_voice_tone.help	EN="Warmth of delivery. Honoured as a voice row or emulated in instructions."	UR="ڈیلیوری کی گرمجوشی۔ آواز کی قطار سے یا ہدایات میں نقل کر کے لاگو ہوتی ہے۔"	OLD="Delivery کی warmth۔ Voice row سے یا instructions میں emulate ہوتی ہے۔"
wire.settings.static.description	EN="Extra directories the local server may serve image, audio, video and HTML previews from. The agent home, session folders, uploads and the working directories of your agents and running sessions are always included."	UR="اضافی ڈائریکٹریز جن سے مقامی سرور تصویر، آڈیو، ویڈیو اور HTML پیش نظارہ دے سکے۔ ایجنٹ ہوم، سیشن فولڈرز، اپ لوڈز اور آپ کے ایجنٹس و چلتے سیشنز کی ورکنگ ڈائریکٹریز ہمیشہ شامل ہیں۔"	OLD="اضافی directories جن سے local server تصویر، audio، video اور HTML previews دے سکے۔ Agent home، session folders، uploads اور آپ کے ایجنٹس و چلتے سیشنز کی working directories ہمیشہ شامل ہیں۔"
wire.settings.static.title	EN="File previews"	UR="فائلوں کے پیش نظارے"	OLD="فائل previews"
wire.settings.static_roots.help	EN="Empty = only the built-in roots. Consulted only by the fallback posture (a connection that is not loopback): normal loopback previews can serve any readable file. Comma-separated absolute directories; dot-directories below a root are never served."	UR="خالی = صرف بلٹ اِن روٹس۔ صرف فال بیک انداز (غیر loopback کنکشن) استعمال کرتی ہے: معمول کے loopback پیش نظارہ کوئی بھی قابل خواندگی فائل دے سکتے ہیں۔ کاما سے الگ مطلق ڈائریکٹریز؛ روٹ کے نیچے ڈاٹ ڈائریکٹریز کبھی پیش نہیں ہوتیں۔"	OLD="خالی = صرف built-in roots۔ صرف fallback posture (غیر loopback connection) استعمال کرتی ہے: معمول کی loopback previews کوئی بھی readable فائل دے سکتی ہیں۔ Comma-separated absolute directories؛ root کے نیچے dot-directories کبھی serve نہیں ہوتیں۔"
wire.settings.static_roots.label	EN="Extra preview roots"	UR="اضافی پیش نظارہ روٹس"	OLD="اضافی preview roots"
wire.settings.static_roots.warning	EN="only applies to the fallback (non-loopback) posture"	UR="صرف فال بیک (non-loopback) انداز پر لاگو"	OLD="صرف fallback (non-loopback) posture پر لاگو"
wire.settings.subagents.description	EN="Concurrency cap, child knowledge slimming, who picks a child's model, and the model each tier runs on."	UR="ہم وقت کام کی حد، ذیلی ایجنٹ کا علم مختصر کرنا، اس کا ماڈل کون منتخب کرے، اور ہر درجے کا ماڈل۔"	OLD="Concurrency حد، child knowledge کم کرنا، child کا ماڈل کون منتخب کرے، اور ہر tier کا ماڈل۔"
wire.settings.subagents_max_running.help	EN="Ceiling on concurrent subagents and backgrounded bash, which share one pool."	UR="ہم وقت چلنے والے ذیلی ایجنٹس اور پس منظر bash کی حد، جو ایک پول بانٹتے ہیں۔"	OLD="Concurrent ذیلی ایجنٹس اور backgrounded bash کی حد، جو ایک pool بانٹتے ہیں۔"
wire.settings.subagents_max_running.label	EN="Max background jobs"	UR="زیادہ سے زیادہ پس منظر کام"	OLD="زیادہ سے زیادہ background jobs"
wire.settings.subagents_max_team_depth.help	EN="Deepest launch allowed in a tree that runs a team. 1 is the top's children."	UR="ٹیم چلانے والے درخت میں گہرائی کی حد۔ 1 کا مطلب اعلیٰ سطح کے ذیلی ایجنٹس۔"	OLD="Team چلانے والے tree میں گہرائی کی حد۔ 1 کا مطلب top کے children۔"
wire.settings.subagents_max_team_depth.label	EN="Max nested-team depth"	UR="نیسٹڈ ٹیم کی زیادہ سے زیادہ گہرائی"	OLD="زیادہ سے زیادہ nested-team گہرائی"
wire.settings.subagents_model_choice.choice.operator.label	EN="the operator"	UR="آپریٹر"	OLD="operator"
wire.settings.subagents_model_choice.help	EN="Who picks a subagent's tier; the operator pins one in its profile."	UR="ذیلی ایجنٹ کا درجہ کون منتخب کرے؛ operator پروفائل میں مقرر کرتا ہے۔"	OLD="ذیلی ایجنٹ کی tier کون منتخب کرے؛ operator profile میں مقرر کرتا ہے۔"
wire.settings.subagents_models_hi.help	EN="Bills at that model's rates; 'default': session; empty removes the tier"	UR="اسی ماڈل کی نرخوں سے بلنگ؛ 'default': سیشن؛ خالی درجہ ہٹاتا ہے"	OLD="اسی ماڈل کی rates سے billing؛ 'default': سیشن؛ خالی tier ہٹاتا ہے"
wire.settings.subagents_models_lo.help	EN="Bills at that model's rates; 'default': session; empty removes the tier"	UR="اسی ماڈل کی نرخوں سے بلنگ؛ 'default': سیشن؛ خالی درجہ ہٹاتا ہے"	OLD="اسی ماڈل کی rates سے billing؛ 'default': سیشن؛ خالی tier ہٹاتا ہے"
wire.settings.subagents_models_med.help	EN="Bills at that model's rates; 'default': session; empty removes the tier"	UR="اسی ماڈل کی نرخوں سے بلنگ؛ 'default': سیشن؛ خالی درجہ ہٹاتا ہے"	OLD="اسی ماڈل کی rates سے billing؛ 'default': سیشن؛ خالی tier ہٹاتا ہے"
wire.settings.subagents_slim_child_knowledge.choice.false.description	EN="inherit the parent block as-is"	UR="پیرنٹ بلاک حرف بہ حرف وراثت میں لے"	OLD="Parent block ویسا ہی inherit کرے"
wire.settings.subagents_slim_child_knowledge.choice.true.description	EN="keep names, trim the rest"	UR="نام رکھیں، باقی مختصر کریں"	OLD="Names رکھیں، باقی کم کریں"
wire.settings.subagents_slim_child_knowledge.help	EN="Keep skill/guide names; trim descriptions and parent extras."	UR="مہارت/گائیڈ کے نام رکھیں؛ تفصیلات اور پیرنٹ کا اضافی مواد مختصر کریں۔"	OLD="Skill/guide names رکھیں؛ descriptions اور parent extras کم کریں۔"
wire.settings.subagents_slim_child_knowledge.label	EN="Slim child knowledge"	UR="ذیلی ایجنٹ کا علم مختصر کریں"	OLD="Child knowledge کم کریں"
wire.settings.supplements.description	EN="After an answer, point out the files it produced and, when you turn it on, draw a chart of numbers it showed. Off by environment: LOP_SUPPLEMENTS=0."	UR="جواب کے بعد بنی فائلیں بتائیں اور، آن کرنے پر، دکھائے نمبروں کا چارٹ بنائیں۔ ماحول سے آف: LOP_SUPPLEMENTS=0۔"	OLD="جواب کے بعد بنی فائلیں بتائیں اور، آن کرنے پر، دکھائے نمبروں کا chart بنائیں۔ Environment سے آف: LOP_SUPPLEMENTS=0۔"
wire.settings.supplements.title	EN="Highlights"	UR="نمایاں حصے"	OLD="Highlights"
wire.settings.supplements_denyprefixes.help	EN="Needs Highlights on. Comma-separated folders whose files are never listed or sent to a decision model; use it on a machine holding customer data."	UR="نمایاں حصے آن ہوں۔ کاما سے الگ فولڈرز جن کی فائلیں کبھی فہرست میں شامل یا فیصلہ ماڈل کو نہیں بھیجتیں؛ گاہکوں کے ڈیٹا والی مشین پر استعمال کریں۔"	OLD="Highlights آن ہوں۔ Comma-separated folders جن کی فائلیں کبھی list یا decision ماڈل کو نہیں جاتی؛ customer data والی machine پر استعمال کریں۔"
wire.settings.supplements_denyprefixes.label	EN="↳ never list under"	UR="↳ ان کے نیچے کبھی فہرست نہ کریں"	OLD="↳ ان کے نیچے کبھی list نہ کریں"
wire.settings.supplements_enabled.help	EN="On: an answer can be followed by a line pointing at the files it made."	UR="آن: جواب کے بعد اس کی بنائی فائلوں کی طرف اشارہ کرنے والی سطر آسکتی ہے۔"	OLD="آن: جواب کے بعد اس کی بنائی فائلوں کی طرف اشارہ کرنے والی line آسکتی ہے۔"
wire.settings.supplements_enabled.label	EN="Highlights"	UR="نمایاں حصے"	OLD="Highlights"
wire.settings.supplements_files.choice.false.description	EN="files are never listed"	UR="فائلیں کبھی فہرست نہیں ہوتیں"	OLD="فائلیں کبھی list نہیں ہوتیں"
wire.settings.supplements_files.choice.true.description	EN="deliverable files are listed"	UR="قابل ترسیل فائلیں فہرست میں آتی ہیں"	OLD="Deliverable فائلیں list ہوتی ہیں"
wire.settings.supplements_files.help	EN="Needs Highlights on. Point out reports and exports an answer produced."	UR="نمایاں حصے آن ہوں۔ جواب کی بنائی رپورٹس اور ایکسپورٹس بتائیں۔"	OLD="Highlights آن ہوں۔ جواب کی بنائی reports اور exports بتائیں۔"
wire.settings.supplements_graphics.choice.false.description	EN="no chart is ever generated"	UR="کبھی چارٹ نہیں بنتا"	OLD="کبھی chart نہیں بنتا"
wire.settings.supplements_graphics.choice.true.description	EN="a chart may be generated (spends tokens)"	UR="چارٹ بن سکتا ہے (ٹوکنز خرچ)"	OLD="Chart بن سکتا ہے (tokens خرچ)"
wire.settings.supplements_graphics.help	EN="Needs Highlights on. Draw a chart when an answer shows numbers. Spends model tokens."	UR="نمایاں حصے آن ہوں۔ جواب میں نمبرز ہوں تو چارٹ بنائیں۔ ماڈل ٹوکنز خرچ ہوتے ہیں۔"	OLD="Highlights آن ہوں۔ جواب میں نمبرز ہوں تو chart بنائیں۔ ماڈل tokens خرچ ہوتے ہیں۔"
wire.settings.supplements_graphics.label	EN="↳ graphics"	UR="↳ گرافکس"	OLD="↳ graphics"
wire.settings.supplements_maxcostusd.help	EN="Needs graphics on. Soft cap on one job's spend."	UR="گرافکس آن ہوں۔ ایک کام کے خرچ کی نرم حد۔"	OLD="Graphics آن ہوں۔ ایک job کے خرچ کی نرم حد۔"
wire.settings.supplements_maxfeatured.help	EN="Needs Highlights on. Files named before the rest fold into 'N more'."	UR="نمایاں حصے آن ہوں۔ اتنی فائلوں کے بعد باقی 'N مزید' میں سمٹ جائیں۔"	OLD="Highlights آن ہوں۔ اتنی فائلوں کے بعد باقی 'N more' میں سمٹ جائیں۔"
wire.settings.supplements_maxoutputtokens.help	EN="Needs graphics on. Output budget per generator turn."	UR="گرافکس آن ہوں۔ فی جنریٹر ٹرن آؤٹ پٹ بجٹ۔"	OLD="Graphics آن ہوں۔ فی generator turn output budget۔"
wire.settings.supplements_maxoutputtokens.label	EN="↳ max output tokens"	UR="↳ زیادہ سے زیادہ آؤٹ پٹ ٹوکنز"	OLD="↳ زیادہ سے زیادہ output tokens"
wire.settings.supplements_maxturns.help	EN="Needs graphics on. Model turns per chart, including one repair."	UR="گرافکس آن ہوں۔ فی چارٹ ماڈل ٹرن، ایک مرمت سمیت۔"	OLD="Graphics آن ہوں۔ فی chart ماڈل turns، ایک repair سمیت۔"
wire.settings.supplements_maxturns.label	EN="↳ max turns"	UR="↳ زیادہ سے زیادہ ٹرن"	OLD="↳ زیادہ سے زیادہ turns"
wire.settings.supplements_model.help	EN="Needs graphics on. auto picks a cheap fast model; session uses this session's."	UR="گرافکس آن ہوں۔ auto سستا تیز ماڈل چنتا ہے؛ session موجودہ سیشن کا ماڈل استعمال کرتا ہے۔"	OLD="Graphics آن ہوں۔ auto سستا تیز ماڈل چنتا ہے؛ session اسی سیشن کا استعمال کرتا ہے۔"
wire.settings.supplements_model.label	EN="↳ graphics model"	UR="↳ گرافکس ماڈل"	OLD="↳ graphics ماڈل"
wire.settings.supplements_timeouts.help	EN="Needs Highlights on. Give up on a whole job after this long."	UR="نمایاں حصے آن ہوں۔ اتنی دیر بعد پورا کام چھوڑ دیں۔"	OLD="Highlights آن ہوں۔ اتنی دیر بعد پوری job چھوڑ دیں۔"
wire.settings.team_bridge.description	EN="Your agent can exchange messages with other members' agents in your organization. Off by default; you can pause or turn it off at any time."	UR="آپ کا ایجنٹ آپ کے ادارے میں دوسرے ممبرز کے ایجنٹس سے پیغامات بدل سکے۔ ڈیفالٹ آف؛ کسی وقت روک یا آف کر سکتے ہیں۔"	OLD="آپ کا ایجنٹ آپ کی organization میں دوسرے members کے ایجنٹس سے پیغامات بدل سکے۔ Default آف؛ کسی وقت pause یا آف کر سکتے ہیں۔"
wire.settings.team_bridge_enabled.help	EN="Off by default. Also needs a Radient sign-in and an eligible organization."	UR="ڈیفالٹ آف۔ Radient سائن اِن اور اہل ادارہ بھی درکار۔"	OLD="Default آف۔ Radient sign-in اور اہل organization بھی درکار۔"
wire.settings.team_bridge_enabled.label	EN="Enabled on this machine"	UR="اس مشین پر فعال"	OLD="اس machine پر فعال"
wire.settings.team_bridge_session.help	EN="Session that may be woken for new messages; empty = badge only."	UR="نئے پیغامات پر جس سیشن کو جگایا جا سکے؛ خالی = صرف بیج۔"	OLD="نئے پیغامات پر جس سیشن کو جگایا جا سکے؛ خالی = صرف badge۔"
wire.settings.tool_approval_mode.choice.ask.description	EN="prompt before write/exec tools"	UR="لکھنے/چلانے والے ٹولز سے پہلے پوچھیں"	OLD="Write/exec ٹولز سے پہلے پوچھیں"
wire.settings.tool_approval_mode.label	EN="Tool approval mode"	UR="ٹول منظوری موڈ"	OLD="ٹول منظوری mode"
wire.settings.tools.description	EN="How the built-in tools execute."	UR="بلٹ اِن ٹولز کیسے چلیں۔"	OLD="Built-in ٹولز کیسے چلیں۔"
wire.settings.tools_defer.help	EN="Keep rarely used tools' schemas out of every request until the agent reads tool://<name> or calls one. The tools stay callable either way. Off sends every schema on every request."	UR="کم استعمال ٹولز کے اسکیما ہر درخواست سے باہر رکھیں یہاں تک کہ ایجنٹ tool://<name> پڑھے یا کوئی کال کرے۔ ٹولز دونوں صورتوں میں کال کیے جا سکتے ہیں۔ آف ہر درخواست میں ہر اسکیما بھیجتا ہے۔"	OLD="کم استعمال ٹولز کے schemas ہر request سے باہر رکھیں یہاں تک کہ ایجنٹ tool://<name> پڑھے یا کوئی call کرے۔ ٹولز دونوں صورتوں میں callable رہتے ہیں۔ آف ہر request میں ہر schema بھیجتا ہے۔"
wire.settings.tools_defer.label	EN="Load rarely used tool schemas on demand"	UR="کم استعمال ٹول اسکیما ضرورت پر لوڈ کریں"	OLD="کم استعمال ٹول schemas ضرورت پر load کریں"
wire.settings.tools_search_interception_block.help	EN="On: the command is refused with a suggestion. Off: it runs anyway and the interception is logged, so an operator can watch before enforcing."	UR="آن: کمانڈ تجویز کے ساتھ مسترد۔ آف: کمانڈ پھر بھی چلتی ہے اور روکاوٹ لاگ ہوتی ہے، تاکہ نفاذ سے پہلے آپریٹر دیکھ سکے۔"	OLD="آن: command تجویز کے ساتھ مسترد۔ آف: command پھر بھی چلتی ہے اور interception log ہوتی ہے، تاکہ نفاذ سے پہلے operator دیکھ سکے۔"
wire.settings.tools_search_interception_enabled.help	EN="Refuse a shell `grep`/`rg`/`find` that recurses from a repository root or a vendor/build tree, and point the agent at the `grep` tool. A scoped or single-file search is never touched. Off disables the check."	UR="ریپوزیٹری روٹ یا وینڈر/بلڈ درخت سے تکراری شیل `grep`/`rg`/`find` روک کر ایجنٹ کو `grep` ٹول بتائیں۔ محدود یا یک فائل تلاش متاثر نہیں۔ آف جانچ بند کرتا ہے۔"	OLD="Repository root یا vendor/build tree سے recursive shell `grep`/`rg`/`find` روک کر ایجنٹ کو `grep` ٹول بتائیں۔ Scoped یا single-file search متاثر نہیں۔ آف check بند کرتا ہے۔"
wire.settings.tools_search_interception_enabled.label	EN="Block unbounded searches"	UR="لامحدود تلاشیں روکیں"	OLD="Unbounded searches روکیں"
wire.settings.tools_search_interception_rg_excludes.help	EN="Give ripgrep a generated config that skips node_modules/.git/out etc., so an `rg` the guard does not block is still fast. Applies to ripgrep only."	UR="ripgrep کو تیار شدہ کنفیگ دیں جو node_modules/.git/out وغیرہ نظر انداز کرے، تاکہ گارڈ کی نہ روکی `rg` بھی تیز رہے۔ صرف ripgrep پر لاگو۔"	OLD="ripgrep کو generated config دیں جو node_modules/.git/out وغیرہ skip کرے، تاکہ guard کی نہ روکی `rg` بھی تیز رہے۔ صرف ripgrep پر لاگو۔"
wire.settings.tools_search_interception_rg_excludes.label	EN="...prune vendor trees for ripgrep"	UR="...ripgrep کے لیے وینڈر درخت حذف کریں"	OLD="...ripgrep کے لیے vendor trees prune کریں"
wire.settings.tui_sidebar_position.help	EN="Which side of the conversation holds the session sidebar."	UR="سیشن سائڈبار گفتگو کے کس طرف ہو۔"	OLD="سیشن sidebar گفتگو کے کس طرف ہو۔"
wire.settings.tui_sidebar_position.label	EN="Sidebar position"	UR="سائڈبار کی جگہ"	OLD="Sidebar کی جگہ"
wire.settings.tui_sidebar_show_subagents.choice.true.description	EN="list recent subagent runs"	UR="حالیہ ذیلی ایجنٹ رنز فہرست کریں"	OLD="حالیہ ذیلی ایجنٹ runs list کریں"
wire.settings.tui_sidebar_show_subagents.help	EN="List recent subagent runs below your own sessions. Ctrl+A toggles the layer while the sidebar has focus."	UR="آپ کے سیشنز کے نیچے حالیہ ذیلی ایجنٹ رنز فہرست کریں۔ سائڈبار فوکسڈ ہو تو Ctrl+A سے تہہ بدلیں۔"	OLD="آپ کے سیشنز کے نیچے حالیہ ذیلی ایجنٹ runs list کریں۔ Sidebar focused ہو تو Ctrl+A سے layer بدلیں۔"
wire.settings.tui_sidebar_show_subagents.label	EN="Sidebar subagent layer"	UR="سائڈبار ذیلی ایجنٹ تہہ"	OLD="Sidebar ذیلی ایجنٹ layer"
wire.settings.tui_sidebar_visible.choice.true.description	EN="show the sidebar"	UR="سائڈبار دکھائیں"	OLD="sidebar دکھائیں"
wire.settings.tui_sidebar_visible.help	EN="Active and recent conversations. Ctrl+B toggles the sidebar."	UR="فعال اور حالیہ گفتگوئیں۔ Ctrl+B سے سائڈبار بدلیں۔"	OLD="فعال اور حالیہ گفتگوئیں۔ Ctrl+B سے sidebar بدلیں۔"
wire.settings.tui_sidebar_visible.label	EN="Session sidebar"	UR="سیشن سائڈبار"	OLD="سیشن sidebar"
wire.settings.tui_theme.help	EN="Colour ramp. /theme switches it live with an arrow-key preview."	UR="رنگوں کا تسلسل۔ /theme arrow-key پیش نظارہ کے ساتھ براہ راست بدلتی ہے۔"	OLD="Colour ramp۔ /theme arrow-key preview کے ساتھ live بدلتی ہے۔"
wire.settings.tui_theme.label	EN="Theme"	UR="تھیم"	OLD="Theme"
wire.settings.wakes.description	EN="When a watched condition goes stale, the assistant is woken to check in rather than left to wait for the daily cadence: the master switch, the per-day budget and spacing, and which sources may fire. Read at the next evaluation pass."	UR="زیر نگرانی حالت پرانی ہو تو اسسٹنٹ روزانہ کیڈنس کے انتظار کے بجائے بیدار ہو کر رابطہ کرے: مرکزی سوئچ، روزانہ بجٹ اور وقفہ، اور کون سے ذرائع متحرک ہو سکتے ہیں۔ اگلے جائزہ پاس پر پڑھی جاتی ہے۔"	OLD="Watched condition stale ہو تو assistant روزانہ cadence کے انتظار کے بجائے بیدار ہو کر check-in کرے: master switch، روزانہ budget اور وقفہ، اور کون سے sources fire کر سکتے ہیں۔ اگلے evaluation pass پر پڑھی جاتی ہے۔"
wire.settings.wakes.title	EN="Wake triggers"	UR="بیداری کے محرکات"	OLD="بیداری triggers"
wire.settings.wakes_triggers_enabled.help	EN="Master switch for trigger wakes; off means no check-in is ever created."	UR="محرک بیداریوں کا مرکزی سوئچ؛ آف پر کوئی رابطہ نہیں بنتا۔"	OLD="Trigger بیداریاں کا master switch؛ آف پر کوئی check-in نہیں بنتا۔"
wire.settings.wakes_triggers_max_per_day.help	EN="Per-target rolling 24 h budget for trigger wakes. 0 disables trigger wakes without touching the switch above."	UR="فی ہدف گردشی 24 h میں محرک بیداریوں کا بجٹ۔ 0 اوپر والے سوئچ کو بدلے بغیر محرک بیداریاں بند کرتا ہے۔"	OLD="فی target rolling 24 h میں trigger بیداریاں کا budget۔ 0 اوپر والے switch کو بدلے بغیر trigger بیداریاں بند کرتا ہے۔"
wire.settings.wakes_triggers_max_per_day.label	EN="Max check-in wakes per day"	UR="روزانہ رابطے کی زیادہ سے زیادہ بیداریاں"	OLD="روزانہ زیادہ سے زیادہ check-in بیداریاں"
wire.settings.wakes_triggers_min_gap_minutes.help	EN="Minimum spacing between trigger wakes to the same target."	UR="ایک ہی ہدف کی محرک بیداریوں کے درمیان کم از کم وقفہ۔"	OLD="ایک ہی target کی trigger بیداریاں کے درمیان کم از کم وقفہ۔"
wire.settings.wakes_triggers_project_staleness_enabled.help	EN="Wake to check in on projects whose progress went stale. Settled (done/paused/archived) projects are never watched."	UR="ان پروجیکٹس پر رابطے کے لیے بیدار ہوں جن کی پیش رفت پرانی ہو۔ مکمل (done/paused/archived) پروجیکٹس کی نگرانی کبھی نہیں۔"	OLD="ان پروجیکٹس پر check-in کے لیے بیدار ہوں جن کی progress stale ہو۔ Settled (done/paused/archived) پروجیکٹس کی نگرانی کبھی نہیں۔"
wire.settings.wakes_triggers_project_staleness_enabled.label	EN="Project staleness trigger"	UR="پروجیکٹ کی پرانی پیش رفت کا محرک"	OLD="پروجیکٹ staleness trigger"
wire.settings.web_fetch.description	EN="Limits and rendering for the fetch tool."	UR="فیچ ٹول کی حدود اور رینڈرنگ۔"	OLD="Fetch ٹول کی حدود اور rendering۔"
wire.settings.web_fetch.title	EN="Web fetch"	UR="ویب فیچ"	OLD="Web fetch"
wire.settings.web_fetch_allow_private.choice.false.description	EN="block private targets"	UR="نجی اہداف روکیں"	OLD="Private targets روکیں"
wire.settings.web_fetch_allow_private.choice.true.description	EN="allow private targets"	UR="نجی اہداف کی اجازت"	OLD="Private targets کی اجازت"
wire.settings.web_fetch_allow_private.help	EN="SSRF guard. On permits loopback, private and link-local targets."	UR="SSRF گارڈ۔ آن loopback، نجی اور link-local اہداف کی اجازت دیتا ہے۔"	OLD="SSRF guard۔ آن loopback، private اور link-local targets کی اجازت دیتا ہے۔"
wire.settings.web_fetch_allow_private.label	EN="Allow private addresses"	UR="نجی ایڈریسز کی اجازت"	OLD="Private addresses کی اجازت"
wire.settings.web_fetch_blocked_retry.choice.true.description	EN="retry refusals once"	UR="مسترد ہونے پر ایک بار دوبارہ کوشش"	OLD="Refusals پر ایک بار retry"
wire.settings.web_fetch_blocked_retry.help	EN="After a refusal, retry once with browser-shaped headers."	UR="مسترد ہونے کے بعد براؤزر جیسے ہیڈرز سے ایک بار دوبارہ کوشش کریں۔"	OLD="Refusal کے بعد browser-shaped headers سے ایک بار retry کریں۔"
wire.settings.web_fetch_blocked_retry.label	EN="Browser-profile retry"	UR="براؤزر پروفائل سے دوبارہ کوشش"	OLD="Browser-profile retry"
wire.settings.web_fetch_cache_ttl_seconds.help	EN="0 disables the URL cache entirely."	UR="0 URL کیشے مکمل بند کرتا ہے۔"	OLD="0 URL cache مکمل بند کرتا ہے۔"
wire.settings.web_fetch_cache_ttl_seconds.label	EN="Cache TTL (s)"	UR="کیشے TTL (s)"	OLD="Cache TTL (s)"
wire.settings.web_fetch_enabled.choice.false.description	EN="fetch disabled"	UR="فیچ بند"	OLD="fetch بند"
wire.settings.web_fetch_enabled.choice.true.description	EN="fetch available"	UR="فیچ دستیاب"	OLD="fetch دستیاب"
wire.settings.web_fetch_enabled.help	EN="Offer the fetch tool and read <url>; off refuses every call."	UR="فیچ ٹول اور read <url> پیش کریں؛ آف ہر کال مسترد کرتا ہے۔"	OLD="Fetch ٹول اور read <url> پیش کریں؛ آف ہر call مسترد کرتا ہے۔"
wire.settings.web_fetch_enabled.label	EN="Web fetch"	UR="ویب فیچ"	OLD="Web fetch"
wire.settings.web_fetch_enrich.choice.false.description	EN="scrape HTML directly"	UR="براہ راست HTML اسکریپ کریں"	OLD="براہ راست HTML scrape کریں"
wire.settings.web_fetch_enrich.choice.true.description	EN="try cleaner sources first"	UR="پہلے صاف ذرائع آزمائیں"	OLD="پہلے صاف sources آزمائیں"
wire.settings.web_fetch_enrich.help	EN="Try .md, llms.txt and content negotiation before scraping HTML."	UR="HTML اسکریپ سے پہلے .md، llms.txt اور مواد کی نگوشی ایشن آزمائیں۔"	OLD="HTML scrape سے پہلے .md، llms.txt اور content negotiation آزمائیں۔"
wire.settings.web_fetch_enrich.label	EN="Enrich before scraping"	UR="اسکریپ سے پہلے بہتر بنائیں"	OLD="Scrape سے پہلے enrich کریں"
wire.settings.web_fetch_max_attempts.help	EN="Retries share the call's timeout, so more attempts never take longer."	UR="دوبارہ کوششیں کال کا ٹائم آؤٹ بانٹتی ہیں، اس لیے زیادہ کوششیں زیادہ وقت نہیں لیتیں۔"	OLD="Retries call کا timeout بانٹتے ہیں، اس لیے زیادہ attempts زیادہ وقت نہیں لیتے۔"
wire.settings.web_fetch_max_attempts.label	EN="Attempts per hop"	UR="فی ہاپ کوششیں"	OLD="فی hop attempts"
wire.settings.web_fetch_max_bytes.help	EN="Enforced during streaming, so a huge page is cut off rather than buffered."	UR="سٹریمنگ کے دوران نافذ، اس لیے بہت بڑا صفحہ بفر کرنے کے بجائے کاٹ دیا جاتا ہے۔"	OLD="Streaming کے دوران نافذ، اس لیے بہت بڑا page buffer کے بجائے cut ہو جاتا ہے۔"
wire.settings.web_fetch_max_bytes.label	EN="Download ceiling (bytes)"	UR="ڈاؤن لوڈ حد (bytes)"	OLD="Download حد (bytes)"
wire.settings.web_fetch_max_redirects.help	EN="Redirect hops followed before giving up."	UR="ہار ماننے سے پہلے کتنے ری ڈائریکٹ ہاپس فالو کیے جائیں۔"	OLD="ہار ماننے سے پہلے follow کیے redirect hops۔"
