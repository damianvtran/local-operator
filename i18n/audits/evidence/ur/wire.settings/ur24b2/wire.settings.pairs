wire.settings.hub_auto_update_teams.help	EN="Merge hub updates into pulled teams automatically."	UR="حاصل کردہ ٹیموں میں hub اپ ڈیٹس خودکار merge کریں۔"	OLD="حاصل کردہ ٹیموں میں hub updates خودکار merge کریں۔"
wire.settings.hub_check_interval_min.help	EN="Minutes between hub update checks (both modes)."	UR="Hub اپ ڈیٹ کی جانچوں کے درمیان منٹ (دونوں موڈز)۔"	OLD="Hub update checks کے درمیان منٹ (دونوں modes)۔"
