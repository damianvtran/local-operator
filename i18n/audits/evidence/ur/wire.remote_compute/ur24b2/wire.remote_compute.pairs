wire.remote_compute.api_override	EN="Remote compute is sending your Radient login and requests to {host} instead of the default Radient API, because LOP_REMOTE_COMPUTE_API_URL is set. Unset it unless you control that host."	UR="LOP_REMOTE_COMPUTE_API_URL سیٹ ہونے کی وجہ سے ریموٹ کمپیوٹ آپ کا Radient لاگ اِن اور درخواستیں پہلے سے طے شدہ Radient API کے بجائے {host} کو بھیج رہا ہے۔ اگر وہ ہوسٹ آپ کے کنٹرول میں نہیں تو اسے ہٹا دیں۔"	OLD="LOP_REMOTE_COMPUTE_API_URL سیٹ ہونے کی وجہ سے ریموٹ کمپیوٹ آپ کا Radient لاگ اِن اور درخواستیں پہلے سے طے شدہ Radient API کے بجائے {host} کو بھیج رہا ہے۔ اگر وہ ہوسٹ آپ کے کنٹرول میں نہیں تو اسے unset کریں۔"
wire.remote_compute.api_override_invalid	EN="LOP_REMOTE_COMPUTE_API_URL must be an https:// URL, or http:// on 127.0.0.1, ::1 or localhost, with no userinfo, query or fragment, no whitespace, control or non-ASCII characters and no percent-encoding; remote compute did not start."	UR="LOP_REMOTE_COMPUTE_API_URL کو https:// URL ہونا چاہیے، یا صرف 127.0.0.1، ::1 یا localhost پر http://؛ اس میں صارف کی معلومات، کوئری یا فرگمنٹ، خالی جگہ، کنٹرول یا غیر ASCII حروف اور پرسنٹ انکوڈنگ نہیں ہو سکتی؛ ریموٹ کمپیوٹ شروع نہیں ہوا۔"	OLD="LOP_REMOTE_COMPUTE_API_URL کو https:// URL ہونا چاہیے، یا صرف 127.0.0.1، ::1 یا localhost پر http://؛ اس میں userinfo، query یا fragment، خالی جگہ، کنٹرول یا غیر ASCII حروف اور percent-encoding نہیں ہو سکتی؛ ریموٹ کمپیوٹ شروع نہیں ہوا۔"
wire.remote_compute.bad_repo	EN="Because this run clones the repository from the far end, --repo must be an https:// or ssh:// URL, or a git@host:path address; a local path cannot be used."	UR="چونکہ یہ رن دور دراز سرور سے ریپوزیٹری clone کرتا ہے، اس لیے --repo کو https:// یا ssh:// URL، یا git@host:path پتہ ہونا چاہیے؛ مقامی پاتھ استعمال نہیں ہو سکتا۔"	OLD="چونکہ یہ رن دور دراز سرور سے repository clone کرتا ہے، اس لیے --repo کو https:// یا ssh:// URL، یا git@host:path پتہ ہونا چاہیے؛ مقامی path استعمال نہیں ہو سکتا۔"
wire.remote_compute.bad_sha	EN="The --sha value must be a full 40-character commit SHA: a branch name or an abbreviated hash could resolve to a different commit than the one this run was submitted for."	UR="--sha کی قدر مکمل 40 حروف کا commit SHA ہونی چاہیے: برانچ نام یا مختصر ہیش اس رن کے جمع کردہ commit کے بجائے کسی اور commit کا حوالہ دے سکتا ہے۔"	OLD="--sha کی قدر مکمل 40 حروف کا commit SHA ہونی چاہیے: برانچ نام یا مختصر hash اس رن کے جمع کردہ commit کے بجائے کسی اور commit پر resolve ہو سکتا ہے۔"
wire.remote_compute.conflict	EN="That idempotency key was already used with a different request body. Pass a new one with --idempotency-key."	UR="یہ idempotency key پہلے ہی کسی مختلف درخواست کے مواد کے ساتھ استعمال ہو چکی ہے۔ --idempotency-key کے ساتھ نئی کلید دیں۔"	OLD="یہ idempotency key پہلے ہی کسی مختلف request body کے ساتھ استعمال ہو چکی ہے۔ --idempotency-key کے ساتھ نئی key دیں۔"
wire.remote_compute.detached	EN="Remote run {run_id} submitted.\nnetwork (confirmed by Radient): {network_id}\nIdempotency key: {idempotency_key}\nFollow it: lop exec --remote-status {run_id}\nCancel it: lop exec --remote-cancel {run_id}"	UR="ریموٹ رن {run_id} جمع کر دیا گیا۔\nنیٹ ورک (Radient کی تصدیق شدہ): {network_id}\nIdempotency key: {idempotency_key}\nاس کی نگرانی: lop exec --remote-status {run_id}\nاسے منسوخ کریں: lop exec --remote-cancel {run_id}"	OLD="ریموٹ رن {run_id} جمع کر دیا گیا۔\nnetwork (Radient کی تصدیق شدہ): {network_id}\nIdempotency key: {idempotency_key}\nاس کی نگرانی: lop exec --remote-status {run_id}\nاسے منسوخ کریں: lop exec --remote-cancel {run_id}"
wire.remote_compute.finished_exit_code	EN="exit code: {exit_code}"	UR="خروجی کوڈ: {exit_code}"	OLD="exit code: {exit_code}"
wire.remote_compute.finished_unknown	EN="Remote run {run_id} is no longer running, but Radient reported no outcome this build can read."	UR="ریموٹ رن {run_id} اب چل نہیں رہا، لیکن Radient نے کوئی ایسا نتیجہ نہیں بتایا جسے یہ بلڈ پڑھ سکے۔"	OLD="ریموٹ رن {run_id} اب چل نہیں رہا، لیکن Radient نے کوئی ایسا نتیجہ نہیں بتایا جسے یہ build پڑھ سکے۔"
wire.remote_compute.invalid_request	EN="Radient rejected the request as invalid. That is a bug in this client, not something to retype."	UR="Radient نے درخواست غلط قرار دے کر مسترد کر دی۔ یہ اس کلائنٹ کا بگ ہے، دوبارہ لکھنے سے حل نہیں ہوگا۔"	OLD="Radient نے درخواست غلط قرار دے کر مسترد کر دی۔ یہ اس کلائنٹ کا bug ہے، دوبارہ لکھنے سے حل نہیں ہوگا۔"
wire.remote_compute.key_empty	EN="An empty --idempotency-key is refused rather than replaced with a fresh key: leave the flag out to mint one, or pass the key of the run you are retrying."	UR="خالی --idempotency-key کو نئی کلید سے بدلنے کے بجائے مسترد کیا جاتا ہے: نئی کلید بنوانے کے لیے اختیار نہ دیں، یا جس رن کی دوبارہ کوشش کر رہے ہیں اسی کی کلید دیں۔"	OLD="خالی --idempotency-key کو نئی key سے بدلنے کے بجائے مسترد کیا جاتا ہے: نئی key بنوانے کے لیے flag نہ دیں، یا جس رن کو retry کر رہے ہیں اسی کی key دیں۔"
wire.remote_compute.key_not_printable	EN="The idempotency key must be printable ASCII: letters, digits and punctuation only, with no accents, tabs or newlines."	UR="idempotency key صرف قابلِ طباعت ASCII حروف پر مشتمل ہونی چاہیے: حروف، اعداد اور اوقاف؛ ایکسنٹ والے حروف، ٹیبز یا نئی سطریں شامل نہیں۔"	OLD="idempotency key صرف printable ASCII ہونی چاہیے: حروف، اعداد اور punctuation marks؛ accents، tabs یا newlines نہیں۔"
wire.remote_compute.key_too_long	EN="The idempotency key is longer than {max_bytes} bytes, which the server refuses: pass a key of at most {max_bytes} bytes."	UR="idempotency key {max_bytes} بائٹس سے لمبی ہے، جو سرور قبول نہیں کرتا: زیادہ سے زیادہ {max_bytes} بائٹس کی کلید دیں۔"	OLD="idempotency key {max_bytes} bytes سے لمبی ہے، جو سرور قبول نہیں کرتا: زیادہ سے زیادہ {max_bytes} bytes کی key دیں۔"
wire.remote_compute.needs_prompt	EN="--remote needs a prompt: pass the task as the one positional argument."	UR="--remote کے لیے پرامپٹ درکار ہے: کام بطور واحد پوزیشنل آرگومنٹ دیں۔"	OLD="--remote کے لیے prompt درکار ہے: کام بطور واحد positional argument دیں۔"
wire.remote_compute.needs_repo	EN="--remote needs --repo <url> and --sha <commit>: this run never uploads local files, so name the repository and commit to check out."	UR="--remote کے لیے --repo <url> اور --sha <commit> درکار ہیں: یہ رن مقامی فائلیں کبھی اپلوڈ نہیں کرتا، اس لیے ریپوزیٹری اور checkout کرنے والا commit بتائیں۔"	OLD="--remote کے لیے --repo <url> اور --sha <commit> درکار ہیں: یہ رن مقامی فائلیں کبھی upload نہیں کرتا، اس لیے repository اور checkout کرنے والا commit بتائیں۔"
wire.remote_compute.network_mismatch	EN="Radient answered with a run from another network, or without a network id, so it cannot be reported as a run of this network."	UR="Radient کے جواب میں رن کسی اور نیٹ ورک کا تھا یا نیٹ ورک ID موجود نہ تھی، اس لیے اسے اس نیٹ ورک کے رن کے طور پر نہیں بتایا جا سکتا۔"	OLD="Radient کے جواب میں رن کسی اور نیٹ ورک کا تھا یا network id موجود نہ تھی، اس لیے اسے اس نیٹ ورک کے رن کے طور پر نہیں بتایا جا سکتا۔"
wire.remote_compute.no_credit	EN="Radient has no compute credit for this account, so the run was not admitted."	UR="اس اکاؤنٹ کے لیے Radient کے پاس کمپیوٹ کریڈٹ نہیں، اس لیے رن قبول نہیں کیا گیا۔"	OLD="اس اکاؤنٹ کے لیے Radient کے پاس compute credit نہیں، اس لیے رن قبول نہیں کیا گیا۔"
wire.remote_compute.replayed	EN="The idempotency key matched an earlier submission, so this is remote run {run_id} and no new run was created."	UR="idempotency key پچھلی جمع کردہ درخواست سے مل گئی، اس لیے یہ ریموٹ رن {run_id} ہے اور کوئی نیا رن نہیں بنایا گیا۔"	OLD="idempotency key پچھلی submission سے مل گئی، اس لیے یہ ریموٹ رن {run_id} ہے اور کوئی نیا رن نہیں بنایا گیا۔"
wire.remote_compute.retrying	EN="Radient reported an error for this run and retries it, so this watch continues."	UR="Radient نے اس رن کی خرابی رپورٹ کی ہے اور اس کی دوبارہ کوشش کر رہا ہے، اس لیے نگرانی جاری رہے گی۔"	OLD="Radient نے اس رن کی خرابی رپورٹ کی ہے اور اسے retry کر رہا ہے، اس لیے نگرانی جاری رہے گی۔"
wire.remote_compute.status_unknown	EN="status: {status} (not a status this build knows; still watching)"	UR="حالت: {status} (یہ بلڈ اس حالت کو نہیں پہنچانتی؛ نگرانی جاری ہے)"	OLD="حالت: {status} (یہ build اس حالت کو نہیں پہنچانتی؛ نگرانی جاری ہے)"
wire.remote_compute.submitted	EN="Remote run {run_id} submitted.\nnetwork (confirmed by Radient): {network_id}"	UR="ریموٹ رن {run_id} جمع کر دیا گیا۔\nنیٹ ورک (Radient کی تصدیق شدہ): {network_id}"	OLD="ریموٹ رن {run_id} جمع کر دیا گیا۔\nnetwork (Radient کی تصدیق شدہ): {network_id}"
wire.remote_compute.unreadable_envelope	EN="Radient's response format has changed, and this lop build cannot read it. Update lop with `lop-update` and try again."	UR="Radient کے جواب کا فارمیٹ بدل گیا ہے، اور lop کی یہ بلڈ اسے نہیں پڑھ سکتی۔ `lop-update` سے lop اپڈیٹ کر کے دوبارہ کوشش کریں۔"	OLD="Radient کے جواب کا format بدل گیا ہے، اور lop کی یہ build اسے نہیں پڑھ سکتی۔ `lop-update` سے lop اپڈیٹ کر کے دوبارہ کوشش کریں۔"
