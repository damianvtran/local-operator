tui.viewer.title	EN="file viewer"	UR="فائل ویور"
tui.viewer.description	EN="View a local text file"	UR="مقامی ٹیکسٹ فائل دیکھیں"
tui.viewer.usage	EN="Usage: /view <path>"	UR="استعمال: /view <path>"
tui.viewer.loading	EN="reading…"	UR="پڑھا جا رہا ہے…"
tui.viewer.legend	EN="↑↓←→ · PgUp/PgDn · Home/End\nw wrap · r reload · y copy path · o open externally · esc close"	UR="↑↓←→ · PgUp/PgDn · Home/End\nw سطریں لپیٹیں · r دوبارہ لوڈ کریں · y پاتھ کاپی کریں · o بیرونی ایپ میں کھولیں · esc بند کریں"
tui.viewer.truncated	EN="Preview truncated — limit: 1 MiB / 20,000 lines"	UR="پیش نظارہ مختصر کر دیا گیا — حد: 1 MiB / 20,000 سطریں"
tui.viewer.unreadable	EN="Cannot read this file — missing, unreadable, or outside permitted roots"	UR="یہ فائل پڑھی نہیں جا سکتی — موجود نہیں، ناقابلِ قرأت ہے، یا اجازت شدہ روٹ ڈائریکٹریوں سے باہر ہے"
tui.viewer.unsupported	EN="This file type has no inline preview — open it externally"	UR="اس قسم کی فائل کے لیے یہاں کوئی پیش نظارہ دستیاب نہیں — اسے بیرونی ایپ میں کھولیں"
tui.viewer.binary	EN="Cannot preview a binary file"	UR="بائنری فائل کا پیش نظارہ نہیں کیا جا سکتا"
tui.viewer.changed	EN="This file changed since it was listed — list it again before opening"	UR="یہ فائل فہرست میں دکھائے جانے کے بعد بدل گئی ہے — کھولنے سے پہلے فائلوں کی فہرست دوبارہ دیکھیں"
tui.viewer.copied	EN="Path copied"	UR="پاتھ کاپی ہو گیا"
tui.viewer.copy_failed	EN="Clipboard unavailable — path: {path}"	UR="کلپ بورڈ دستیاب نہیں — پاتھ: {path}"
tui.viewer.open_failed	EN="Could not open this file externally"	UR="یہ فائل بیرونی ایپ میں نہیں کھل سکی"
tui.viewer.kind_code	EN="code"	UR="کوڈ"
tui.viewer.kind_markdown	EN="markdown"	UR="Markdown"
tui.viewer.kind_text	EN="text"	UR="ٹیکسٹ"
tui.viewer.header	EN="{path} · {kind} · {size} B"	UR="{path} · {kind} · {size} B"
tui.viewer.wrap_on	EN="Wrapping on"	UR="سطریں لپیٹنا چالو"
tui.viewer.wrap_off	EN="Wrapping off"	UR="سطریں لپیٹنا بند"
