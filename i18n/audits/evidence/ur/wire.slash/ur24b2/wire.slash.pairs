wire.slash.agent	EN="List agents, switch an agent's class, or speak to this session as one"	UR="ایجنٹس دیکھیں، کسی ایجنٹ کی قسم بدلیں، یا اس سیشن سے بطور ایجنٹ بات کریں"	OLD="ایجنٹس دیکھیں، class بدلیں، یا ایجنٹ بن کر بات کریں"
wire.slash.approvals	EN="Show or set tool approval mode for this session"	UR="اس سیشن کے لیے ٹول منظوری کا موڈ دیکھیں یا مقرر کریں"	OLD="اس سیشن کے لیے ٹول منظوری کا mode دیکھیں یا مقرر کریں"
wire.slash.copy	EN="Copy an agent message or code block"	UR="ایجنٹ کا پیغام یا کوڈ بلاک نقل کریں"	OLD="ایجنٹ کا پیغام یا code block نقل کریں"
wire.slash.credential	EN="Type or paste a secret after a space; masked"	UR="اسپیس کے بعد خفیہ متن لکھیں/چسپاں کریں؛ متن چھپا رہے گا"	OLD="space کے بعد secret لکھیں/paste کریں؛ حروف چھپے رہیں گے"
wire.slash.failovers	EN="Show the model failover cascade and what is serving"	UR="ماڈل فیل اوور کی ترتیب اور فعال ماڈل دکھائیں"	OLD="ماڈل failover کی ترتیب اور فعال ماڈل دکھائیں"
wire.slash.fast	EN="Toggle faster output at premium pricing"	UR="زیادہ قیمت پر تیز آؤٹ پٹ چالو/بند کریں"	OLD="زیادہ قیمت پر تیز output کو آن/آف کریں"
wire.slash.fork	EN="Branch this chat; --switch here, --window elsewhere; <message> starts work"	UR="اس گفتگو کی شاخ بنائیں؛ --switch یہیں، --window کہیں اور؛ <message> سے کام شروع کریں"	OLD="شاخ؛ --switch یہیں، --window باہر؛ <message> آغاز کرے"
wire.slash.highlights	EN="Cancel, retry or steer the highlights under an answer"	UR="جواب کے نمایاں حصے منسوخ کریں، دوبارہ کوشش کریں یا رخ بدلیں"	OLD="جواب کے نمایاں حصے منسوخ، دوبارہ آزمائیں یا رخ بدلیں"
wire.slash.hub	EN="Open Hub links — per-link subscribe and auto-push policy"	UR="Hub روابط کھولیں — فی ربط رکنیت اور خودکار push پالیسی"	OLD="Hub links کھولیں — فی link رکنیت اور auto-push پالیسی"
wire.slash.links	EN="Open a link from this conversation in a browser"	UR="اس گفتگو کا ربط براؤزر میں کھولیں"	OLD="اس گفتگو کا link browser میں کھولیں"
wire.slash.login	EN="Authenticate a provider"	UR="پرووائیڈر میں لاگ اِن کریں"	OLD="provider میں لاگ اِن کریں"
wire.slash.logout	EN="Remove stored provider credentials"	UR="محفوظ پرووائیڈر کریڈینشلز ہٹائیں"	OLD="محفوظ provider کریڈینشلز ہٹائیں"
wire.slash.loop	EN="Loop toward a goal: /loop <goal>, <n>; --stop cancels"	UR="ہدف تک لوپ: /loop <goal>, <n>؛ --stop سے منسوخ"	OLD="ہدف تک loop: /loop <goal>, <n>؛ --stop سے منسوخ"
wire.slash.mcp	EN="List MCP servers; add/remove one, or manage an OAuth grant"	UR="MCP سرورز دیکھیں/شامل/ہٹائیں؛ OAuth اجازت منظم کریں"	OLD="MCP servers دیکھیں/add/remove؛ OAuth grant منظم کریں"
wire.slash.move	EN="Change this session's working directory"	UR="اس سیشن کی ورکنگ ڈائریکٹری بدلیں"	OLD="اس سیشن کی working directory بدلیں"
wire.slash.network	EN="Networks, peers, and this device's mesh state"	UR="نیٹ ورکس، پیئرز اور اس ڈیوائس کی میش حالت"	OLD="نیٹ ورکس، peers اور اس ڈیوائس کی mesh حالت"
wire.slash.provider	EN="List providers and their login/usage state"	UR="پرووائیڈرز اور ان کے لاگ اِن/استعمال کی حالت کی فہرست"	OLD="providers اور ان کی لاگ اِن/استعمال کی حالت کی فہرست"
wire.slash.reload	EN="Relaunch this conversation on the current install"	UR="موجودہ انسٹال پر یہ گفتگو دوبارہ چلائیں"	OLD="موجودہ install سے یہ گفتگو دوبارہ چلائیں"
wire.slash.search	EN="Configure web search providers and load balancing"	UR="ویب تلاش کے پرووائیڈرز اور لوڈ بیلنسنگ ترتیب دیں"	OLD="ویب تلاش کے providers اور load balancing ترتیب دیں"
wire.slash.team	EN="List teams, chart a team's org, or send a request to a team's manager"	UR="ٹیمیں اور تنظیمی خاکہ دیکھیں؛ مینیجر کو درخواست بھیجیں"	OLD="ٹیمیں اور تنظیمی خاکہ دیکھیں؛ manager کو درخواست بھیجیں"
wire.slash.theme	EN="Switch color theme; arrows preview live"	UR="رنگی تھیم بدلیں؛ ایرو کیز سے براہِ راست پیش منظر"	OLD="رنگی تھیم بدلیں؛ arrow keys سے براہِ راست پیش منظر"
wire.slash.update	EN="Install the latest version from PyPI and relaunch"	UR="PyPI سے تازہ ورژن انسٹال کر کے دوبارہ شروع کریں"	OLD="PyPI سے تازہ ورژن install کر کے دوبارہ شروع کریں"
wire.slash.usage	EN="Show provider usage quota"	UR="پرووائیڈر کا استعمالی کوٹہ دکھائیں"	OLD="provider کا usage quota دکھائیں"
