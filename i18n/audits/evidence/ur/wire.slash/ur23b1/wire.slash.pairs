wire.slash.accounts	EN="List stored credentials"	UR="محفوظ کریڈینشلز کی فہرست"
wire.slash.agent	EN="List agents, switch an agent's class, or speak to this session as one"	UR="ایجنٹس دیکھیں، class بدلیں، یا ایجنٹ بن کر بات کریں"
wire.slash.aida	EN="Open your chief of staff, or send her a request"	UR="اپنی چیف آف اسٹاف کھولیں، یا اسے درخواست بھیجیں"
wire.slash.analytics	EN="Aggregated token-consumption analytics across all sessions"	UR="تمام سیشنز کے ٹوکن استعمال کے مجموعی تجزیات"
wire.slash.approvals	EN="Show or set tool approval mode for this session"	UR="اس سیشن کے لیے ٹول منظوری کا mode دیکھیں یا مقرر کریں"
wire.slash.archive	EN="Hide from the lists, still resumable by id"	UR="فہرستوں سے چھپائیں؛ id سے دوبارہ کھولا جا سکتا ہے"
wire.slash.btw	EN="Ask a side question off the record (esc closes it)"	UR="الگ سوال پوچھیں، ریکارڈ سے باہر (esc سے بند)"
wire.slash.clear	EN="Clear the transcript (history is untouched)"	UR="ٹرانسکرپٹ صاف کریں (ماضی کا ریکارڈ محفوظ رہے گا)"
wire.slash.compact	EN="Compact the context now"	UR="ابھی سیاق و سباق کی کمپریشن کریں"
wire.slash.context	EN="Show prompt, tool-schema and message token usage"	UR="پرامپٹ، ٹول اسکیما اور پیغامات کے ٹوکن استعمال دکھائیں"
wire.slash.copy	EN="Copy an agent message or code block"	UR="ایجنٹ کا پیغام یا code block نقل کریں"
wire.slash.credential	EN="Type or paste a secret after a space; masked"	UR="space کے بعد secret لکھیں/paste کریں؛ حروف چھپے رہیں گے"
wire.slash.delete	EN="Delete this conversation for good; asks to confirm"	UR="یہ گفتگو ہمیشہ کے لیے حذف کریں؛ تصدیق مانگی جائے گی"
wire.slash.effort	EN="Show or set reasoning effort (shift+tab cycles)"	UR="استدلال کی سطح دیکھیں یا مقرر کریں (shift+tab سے بدلیں)"
wire.slash.exit	EN="Quit the app"	UR="ایپ سے باہر نکلیں"
wire.slash.failovers	EN="Show the model failover cascade and what is serving"	UR="ماڈل failover کی ترتیب اور فعال ماڈل دکھائیں"
wire.slash.fast	EN="Toggle faster output at premium pricing"	UR="زیادہ قیمت پر تیز output کو آن/آف کریں"
wire.slash.fork	EN="Branch this chat; --switch here, --window elsewhere; <message> starts work"	UR="شاخ؛ --switch یہیں، --window باہر؛ <message> آغاز کرے"
wire.slash.goal	EN="Set the goal and start work; /goal --clear clears it"	UR="ہدف مقرر کر کے کام شروع کریں؛ /goal --clear سے صاف کریں"
wire.slash.help	EN="List all commands"	UR="تمام کمانڈز کی فہرست"
wire.slash.highlights	EN="Cancel, retry or steer the highlights under an answer"	UR="جواب کے نمایاں حصے منسوخ، دوبارہ آزمائیں یا رخ بدلیں"
wire.slash.hub	EN="Open Hub links — per-link subscribe and auto-push policy"	UR="Hub links کھولیں — فی link رکنیت اور auto-push پالیسی"
wire.slash.info	EN="Install, version, and running sessions on this machine"	UR="انسٹال، ورژن اور اس مشین کے چلتے سیشنز"
wire.slash.keys	EN="Show the keyboard legend"	UR="کی بورڈ کی رہنما کلیدیں دکھائیں"
wire.slash.language	EN="Show or set the UI language; auto follows the system"	UR="UI زبان دیکھیں/مقرر کریں؛ auto سسٹم کی پیروی کرتا ہے"
wire.slash.links	EN="Open a link from this conversation in a browser"	UR="اس گفتگو کا link browser میں کھولیں"
wire.slash.login	EN="Authenticate a provider"	UR="provider میں لاگ اِن کریں"
wire.slash.logout	EN="Remove stored provider credentials"	UR="محفوظ provider کریڈینشلز ہٹائیں"
wire.slash.loop	EN="Loop toward a goal: /loop <goal>, <n>; --stop cancels"	UR="ہدف تک loop: /loop <goal>, <n>؛ --stop سے منسوخ"
wire.slash.mcp	EN="List MCP servers; add/remove one, or manage an OAuth grant"	UR="MCP servers دیکھیں/add/remove؛ OAuth grant منظم کریں"
wire.slash.mobile	EN="Radient phone access: status, enable, stop, billing"	UR="Radient فون رسائی: حالت، فعال کرنا، روکنا، بلنگ"
wire.slash.model	EN="Switch model; /model default saves it for new sessions"	UR="ماڈل بدلیں؛ /model default نئے سیشنز کے لیے محفوظ کریں"
wire.slash.move	EN="Change this session's working directory"	UR="اس سیشن کی working directory بدلیں"
wire.slash.network	EN="Networks, peers, and this device's mesh state"	UR="نیٹ ورکس، peers اور اس ڈیوائس کی mesh حالت"
wire.slash.new	EN="Start a new conversation"	UR="نئی گفتگو شروع کریں"
wire.slash.notifications	EN="Unread completions; read marks them read"	UR="ناپڑھی تکمیل کی اطلاعات؛ پڑھنے پر پڑھی گئی نشان زد"
wire.slash.project	EN="Track workstreams: list, show, new, delete, link, unlink"	UR="ورک اسٹریمز: list, show, new, delete, link, unlink"
wire.slash.provider	EN="List providers and their login/usage state"	UR="providers اور ان کی لاگ اِن/استعمال کی حالت کی فہرست"
wire.slash.reload	EN="Relaunch this conversation on the current install"	UR="موجودہ install سے یہ گفتگو دوبارہ چلائیں"
wire.slash.rename	EN="Name this conversation, or /title --refresh"	UR="اس گفتگو کو نام دیں، یا /title --refresh"
wire.slash.resume	EN="Pick a past conversation to resume, or resume one (id)"	UR="پرانی گفتگو منتخب کر کے جاری رکھیں، یا id دیں"
wire.slash.search	EN="Configure web search providers and load balancing"	UR="ویب تلاش کے providers اور load balancing ترتیب دیں"
wire.slash.session	EN="Usage, cost, diagnostics; --copy copies the session ID"	UR="استعمال، لاگت، تشخیص؛ --copy سیشن ID نقل کرتا ہے"
wire.slash.settings	EN="Change every setting on one page"	UR="تمام ترتیبات ایک صفحے پر بدلیں"
wire.slash.sidebar	EN="Show or hide conversations; 'focus' keys the list"	UR="گفتگوئیں دکھائیں/چھپائیں؛ 'focus' سے فہرست پر جائیں"
wire.slash.skills	EN="List loaded skills"	UR="لوڈ شدہ مہارتیں دکھائیں"
wire.slash.stop	EN="End this session, another by name/pid, or all — /resume reopens it"	UR="سیشن بند کریں: یہ، دوسرا (نام/pid) یا سب؛ /resume کھولے"
wire.slash.team	EN="List teams, chart a team's org, or send a request to a team's manager"	UR="ٹیمیں اور تنظیمی خاکہ دیکھیں؛ manager کو درخواست بھیجیں"
wire.slash.theme	EN="Switch color theme; arrows preview live"	UR="رنگی تھیم بدلیں؛ arrow keys سے براہِ راست پیش منظر"
wire.slash.unarchive	EN="Show this conversation in the lists again"	UR="یہ گفتگو دوبارہ فہرستوں میں دکھائیں"
wire.slash.update	EN="Install the latest version from PyPI and relaunch"	UR="PyPI سے تازہ ورژن install کر کے دوبارہ شروع کریں"
wire.slash.usage	EN="Show provider usage quota"	UR="provider کا usage quota دکھائیں"
