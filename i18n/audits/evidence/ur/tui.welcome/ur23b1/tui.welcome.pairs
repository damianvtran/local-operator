tui.welcome.tip.approvals	EN="/approvals <ask|auto> sets whether tools ask first"	UR="ٹولز کا پہلے پوچھنا: /approvals <ask|auto>"
tui.welcome.tip.classification_login	EN="lop login <radient|typesafe|openrouter> enables hints"	UR="اشارے چالو — lop login <radient|typesafe|openrouter>"
tui.welcome.tip.classification_off	EN="lop config edit classification.auto false turns hints off"	UR="اشارے بند — lop config edit classification.auto false"
tui.welcome.tip.cmux	EN="Under cmux, Where it opens sets workspace or surface"	UR="cmux میں “کہاں کھلے” سے ورک اسپیس یا سرفیس مقرر ہوتا ہے"
tui.welcome.tip.esc	EN="esc stops the agent without ending the session"	UR="esc ایجنٹ روکتا ہے، سیشن ختم کیے بغیر"
tui.welcome.tip.fork	EN="/fork branches; /fork <message> starts divergent work"	UR="/fork شاخ بناتا ہے؛ /fork <message> الگ کام شروع کرتا ہے"
tui.welcome.tip.fork_placement	EN="/settings → Fork → Where a fork opens sets placement"	UR="/settings → Fork → “فورک کہاں کھلے” سے مقام طے ہوتا ہے"
tui.welcome.tip.hotkeys	EN="/settings → Hotkeys remaps these keys"	UR="/settings → Hotkeys سے یہ کلیدیں بدلیں"
tui.welcome.tip.key_new_session	EN="'{key}' starts a new conversation"	UR="'{key}' سے نئی گفتگو شروع ہوتی ہے"
tui.welcome.tip.key_resume	EN="'{key}' reopens a recent conversation"	UR="'{key}' سے حالیہ گفتگو کھولیں"
tui.welcome.tip.mesh	EN="/network new <name> makes a mesh other devices can join"	UR="/network new <name> سے دوسرے ڈیوائسز کا میش بنائیں"
tui.welcome.tip.model	EN="/model <provider>/<id> switches this session only"	UR="/model <provider>/<id> صرف اسی سیشن پر لاگو ہوتا ہے"
tui.welcome.tip.paste	EN="ctrl+v attaches an image from the system clipboard"	UR="ctrl+v سسٹم کلپ بورڈ سے تصویر منسلک کرتا ہے"
tui.welcome.tip.resume	EN="/resume picks up a recent session where you left off"	UR="/resume سے حالیہ سیشن وہیں سے جاری رکھیں"
tui.welcome.tip.setup	EN="New here? {login} is one browser sign-in; no key to paste"	UR="نئے ہیں؟ {login} براؤزر سائن ان ہے؛ کلید پیسٹ نہیں کرنی"
tui.welcome.tip.shell	EN="! on an empty composer runs a shell command"	UR="خالی کمپوزر میں ! شیل کمانڈ چلاتا ہے"
tui.welcome.tip.subagents	EN="Ask for parallel work and the agent fans out subagents"	UR="متوازی کام کہیں؛ ایجنٹ کام ذیلی ایجنٹس میں بانٹ دیتا ہے"
tui.welcome.tip.team	EN="/team <name> <message> sends work to the manager"	UR="/team <name> <message> مینیجر کو کام بھیجتا ہے"
