===== COMMAND: .venv/bin/python _pad_cells behaviour probe =====
_pad_cells source:
def _pad_cells(text: str, cells: int) -> str:
    """Right-align ``text`` in ``cells`` terminal cells (never truncating).

    The complement of ``truncate_cells``: a cell budget needs cell-aware
    padding, because a wide character occupies two columns and a combining
    mark none.
    """
    return " " * max(0, cells - cell_len(text)) + text

  _pad_cells('刚刚', 5) -> ' 刚刚' cells=5 exact=True overrun=0
  _pad_cells('now', 5) -> '  now' cells=5 exact=True overrun=0
  _pad_cells('123456789', 5) -> '123456789' cells=9 exact=False overrun=4
  _pad_cells('Release triage', 12) -> 'Release triage' cells=14 exact=False overrun=2
  _pad_cells('', 5) -> '     ' cells=5 exact=True overrun=0

