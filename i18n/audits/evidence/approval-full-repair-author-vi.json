  "additional_changes": [
    {
      "key": "wire.settings.bash_memory_mode.help",
      "backtranslation": "'auto' derives the ceiling from the memory this device has free right now, so it tightens on its own when the machine is busy. 'manual' pins it to the number below."
    },
    {
      "key": "wire.settings.classification_vendor.help",
      "backtranslation": "Needs recommendations on. Pin one leg; auto prefers Radient."
    },
    {
      "key": "wire.settings.compaction_strategy.help",
      "backtranslation": "Which mechanism compacts. Auto picks per model."
    },
    {
      "key": "wire.settings.display_nerd_icons.help",
      "backtranslation": "Expanded tool-row icons. Auto reads the terminal emulator's markers."
    },
    {
      "key": "wire.settings.fork_cmux_placement.choice.surface.description",
      "backtranslation": "A tab in the current workspace."
    },
    {
      "key": "wire.settings.providers_openrouter_allow_fallbacks.help",
      "backtranslation": "'default' sends nothing (OpenRouter falls through to another host when the preferred one fails); 'false' fails rather than fall through to a host outside your preferences."
    },
    {
      "key": "wire.settings.providers_openrouter_data_collection.help",
      "backtranslation": "'deny' excludes hosts that may train on or retain your prompts. 'default' sends no preference (OpenRouter's default: allow)."
    },
    {
      "key": "wire.settings.providers_openrouter_enforce_distillable_text.help",
      "backtranslation": "'true': restrict to endpoints whose text output may be distilled. 'default': nothing sent."
    },
    {
      "key": "wire.settings.providers_openrouter_require_parameters.help",
      "backtranslation": "'true' restricts to hosts that support every parameter you send (tools, structured output); 'default' lets OpenRouter silently drop unsupported ones."
    },
    {
      "key": "wire.settings.providers_openrouter_sort.help",
      "backtranslation": "How OpenRouter ranks hosts for this call. May route away from the host holding your warm prompt cache (a cold start on long conversations); 'default' sends no preference at all."
    },
    {
      "key": "wire.settings.providers_openrouter_zdr.help",
      "backtranslation": "'true': restrict to zero-data-retention endpoints. 'default': nothing sent."
    },
    {
      "key": "wire.settings.session_scratchpad.description",
      "backtranslation": "What one session's own scratch area may hold. The cap is checked on every write and applies immediately."
    },
    {
      "key": "wire.settings.shell_environment_mode.help",
      "backtranslation": "'inherit' lets a command the agent runs see your environment (gh, aws, npm keep their tokens). 'allowlist' passes only PATH/HOME/SHELL/TERM/USER/LOGNAME plus the two lists beside this, so the provider key this session launched with is not handed to a command the model writes. Read once per session: changing it takes effect at the next launch."
    },
    {
      "key": "wire.settings.speech_transcription_cleanup.help",
      "backtranslation": "How dictation strips filler words and non-speech cues. auto uses the provider's native cleanup where available and the conservative client rules elsewhere; provider and client each use only one of the two mechanisms; off keeps the verbatim transcript. A per-request `cleanup` field still wins."
    },
    {
      "key": "wire.settings.speech_voice_expressiveness.choice.medium.description",
      "backtranslation": "Standard vocal delivery."
    },
    {
      "key": "wire.settings.speech_voice_gender.help",
      "backtranslation": "auto picks per agent; a fixed value overrides the classifier."
    },
    {
      "key": "wire.settings.tool_approval_mode.choice.ask.label",
      "backtranslation": "Ask first."
    },
    {
      "key": "wire.settings.web_fetch_render_backend.help",
      "backtranslation": "Auto uses markdownify when the [fetch] extra is installed."
    }
  ],
