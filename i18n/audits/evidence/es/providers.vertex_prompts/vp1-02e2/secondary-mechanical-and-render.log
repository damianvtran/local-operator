import json,re,unicodedata
from pathlib import Path
from rich.cells import cell_len
from local_operator.i18n.messages import render
root=Path.cwd(); ns='providers.vertex_prompts'; en=json.loads((root/f'local_operator/i18n/catalogues/en/{ns}.json').read_text())
for loc in ['fr','es','zh-CN','ru','vi','ur','hi']:
 data=json.loads((root/f'local_operator/i18n/catalogues/{loc}/{ns}.json').read_text()); assert set(data)==set(en)
 for k,v in data.items():
  assert re.findall(r'\{[^{}]+\}',v)==re.findall(r'\{[^{}]+\}',en[k]),(loc,k)
  assert not any(unicodedata.bidirectional(c) in ['LRE','RLE','LRO','RLO','PDF','LRI','RLI','FSI','PDI'] or c in '\u200e\u200f\u061c' for c in v),(loc,k)
  assert unicodedata.normalize('NFC',v)==v,(loc,k)
  assert v.endswith(' ')==en[k].endswith(' '),(loc,k)
  if k.endswith('project_id'): assert 'Google Cloud' in v and 'JSON' not in v
  if k.endswith('service_account'): assert v.count('JSON')==2
  if k.endswith('hint.required'): assert v.count('Enter')==2 and v.count('Esc')==1
  assert '<' not in v and '`' not in v and ', plural,' not in v and ', select,' not in v
 print(loc,'PASS: 4 keys, placeholder/NFC/token/bidi/trailing-space checks; cells='+str({k.rsplit('.',1)[-1]:cell_len(v) for k,v in data.items()}))
 label=data[ns+'.field.project_id']; composed=render(ns+'.prompt.field',{'field':label},locale=loc)
 assert composed==data[ns+'.prompt.field'].replace('{field}',label),(loc,composed)
 print('actual messages.render composition:',composed)

