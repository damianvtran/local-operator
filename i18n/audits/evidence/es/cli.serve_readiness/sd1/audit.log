import json,re,unicodedata
from pathlib import Path
from local_operator.i18n import runtime as rt
from rich.cells import cell_len
base=Path('local_operator/i18n/catalogues')
ns='cli.serve_readiness'
def strict(path):
    def pairs(items):
        result={}
        for key,value in items:
            assert key not in result, ('duplicate JSON key',key)
            result[key]=value
        return result
    return json.loads(path.read_text(),object_pairs_hook=pairs)
en=strict(base/'en'/f'{ns}.json'); es=strict(base/'es'/f'{ns}.json'); context=strict(base/'en'/f'{ns}.context.json')
assert set(en)==set(es)==set(context) and len(es)==11
print('STRICT JSON/key/context parity: PASS, 11 keys, no duplicate/added/dropped keys')
def branches(text):
    nodes=rt.parse_message(text)
    if len(nodes)==1 and getattr(nodes[0],'kind',None)=='plural':
        return dict(nodes[0].parts)
    return {'plain':nodes}
def argtypes(nodes):
    return [(n.name,n.kind,n.skeleton) for n in nodes if hasattr(n,'kind')]
def literals(nodes):
    return ''.join(n.value for n in nodes if hasattr(n,'value'))
params={'device':'node-1','pids':'123, 456','holders':'custom.service','builds':'build-old','install':'build-new','recorded':'build-old','reasons':'pid 123: identidad sin comprobar'}
for key in en:
    assert rt.message_arguments(en[key])==rt.message_arguments(es[key]),key
    eb=branches(en[key]); sb=branches(es[key])
    if 'plain' not in eb:
        assert set(eb)=={'one','other'} and set(sb)=={'one','many','other'},key
    for selector,nodes in sb.items():
        source_nodes=eb.get(selector,eb.get('other'))
        assert argtypes(nodes)==argtypes(source_nodes),(key,selector,'branch argument types')
        a=literals(source_nodes); b=literals(nodes)
        assert re.findall(r'`[^`]*`',a)==re.findall(r'`[^`]*`',b),(key,selector,'code spans')
        assert re.findall(r'</?[A-Za-z][^>]*>',a)==re.findall(r'</?[A-Za-z][^>]*>',b),(key,selector,'tags')
    assert not any(unicodedata.category(c)=='Cf' for c in es[key]),key
    assert unicodedata.normalize('NFC',es[key])==es[key],key
    hints={k:v for k,v in context[key].items() if k in ('maxCells','maxChars')}
    print(key, 'PASS args='+str(rt.message_arguments(es[key]))+' selectors='+str(rt.plural_selectors(es[key]))+' width_hints='+str(hints))
    counts=(0,1,2,1000000) if 'plain' not in sb else (1,)
    for count in counts:
        rendered=rt.render_message(es[key],dict(params,count=count),'es')
        print('  count='+str(count)+' cells='+str(cell_len(rendered))+' chars='+str(len(rendered))+': '+rendered)
print('Independent branch-level checks PASS; no maxCells/maxChars in sidecar; sample widths are descriptive, not a rendered UI/layout certification.')

