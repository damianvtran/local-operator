    {
      "term": "unseen",
      "decision": "Use «(не просмотрено)» for neuter impersonal outcomes and «(не просмотрена)» with «Ошибка». It means the existing result has not been viewed, never a new interruption/error."
    },
    {
      "term": "retired",
      "decision": "Use «для обновления» explicitly, not operator stop; legacy retired_label is preserved byte-for-byte as a value."
    },
    {
      "term": "signal vs forced kill",
      "decision": "«процесс остановлен сигналом» versus «процесс принудительно завершён». The unknown-command sentinel none emits no attribution; real command bytes follow «по команде» unchanged."
    },
    {
      "term": "dormant wakes",
      "decision": "«пробуждение приостановлено» and inflected Russian count arms distinguish dormancy from cancellation or an active firing schedule."
    },
    {
      "term": "disposed",
      "decision": "«сессия окончательно закрыта» avoids asserting that stored session data was deleted; source says disposed, not deleted."
    },
    {
      "term": "install replaced",
      "decision": "«установленная копия заменена» refers to the installation, not the update operation itself."
    }
