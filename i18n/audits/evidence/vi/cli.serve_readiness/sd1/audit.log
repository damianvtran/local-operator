$ .venv/bin/python -c 'import json, re, unicodedata, hashlib
from pathlib import Path
from collections import Counter
from local_operator.i18n.runtime import message_arguments, parse_message, plural_selectors, render_message
from rich.cells import cell_len
root = Path.cwd()
ns = "cli.serve_readiness"
def unique(pairs):
    out = {}
    for key, value in pairs:
        assert key not in out, ("duplicate key", key)
        out[key] = value
    return out
def load(path):
    return json.loads(path.read_text(), object_pairs_hook=unique)
en = load(root / f"local_operator/i18n/catalogues/en/{ns}.json")
vi = load(root / f"local_operator/i18n/catalogues/vi/{ns}.json")
context = load(root / f"local_operator/i18n/catalogues/en/{ns}.context.json")
assert len(en) == len(vi) == 11
assert en.keys() == vi.keys() == context.keys()
params = dict(count=1, device="node-a", pids="123, 456", builds="v1, v2", install="v3", holders="pid 123 under example.service", recorded="v1", reasons="pid 123: " + vi[ns + ".unproven"])
for key, target in vi.items():
    source = en[key]
    parse_message(source); parse_message(target)
    assert message_arguments(source) == message_arguments(target), key
    branches = plural_selectors(target)
    assert all(set(arms) == {"other"} for arms in branches), (key, branches)
    assert unicodedata.normalize("NFC",target) == target, (key,"not NFC")
    assert not any(unicodedata.category(char) in ("Mn", "Me") for char in target), (key,"combining marks")
    assert not any(unicodedata.bidirectional(char) in ("RLE","LRE","RLO","LRO","PDF","LRI","RLI","FSI","PDI") for char in target), (key,"bidi controls")
    # English plural alternatives repeat literals. Compare the literal set,
    # then verify the one Vietnamese branch keeps each applicable literal.
    assert set(re.findall(r"`([^`]+)`",source)) == set(re.findall(r"`([^`]+)`",target)), (key,"code literal drift")
    assert target.count("`") % 2 == 0, key
    assert re.findall(r"</?[A-Za-z][^>]*>|\[/?[A-Za-z][^\]]*\]",source) == re.findall(r"</?[A-Za-z][^>]*>|\[/?[A-Za-z][^\]]*\]",target), (key,"markup drift")
    rendered = render_message(target, params, "vi")
    hint = context[key]
    assert "maxChars" not in hint or len(rendered) <= hint["maxChars"], key
    assert "maxCells" not in hint or cell_len(rendered) <= hint["maxCells"], key
    print(key, "PASS", "args="+repr(message_arguments(target)), "plural="+repr(branches), "sample_chars="+str(len(rendered)), "sample_cells="+str(cell_len(rendered)), "budget="+repr({k:v for k,v in hint.items() if k in ("maxCells","maxChars")}))
    print("  sample:", rendered)
    if branches:
        # Exercise the complete vi CLDR category for zero, one and many.
        for count in (0, 1, 2, 5, 101):
            assert render_message(target, dict(params, count=count), "vi") == rendered
        print("  plural samples 0,1,2,5,101: PASS (vi other only)")
print("ALL 11: JSON/duplicate keys/key parity/context parity/argument name+kind+order/ICU/vi categories/code+markup/NFC/no combining marks/no bidi controls passed")
print("No width hints in sidecar; measurements are illustrative inserted values, not a live rendered UI or universal width bound")
for locale in ("en","vi"):
    path = root / f"local_operator/i18n/catalogues/{locale}/{ns}.json"
    print("SHA256",str(path.relative_to(root)),hashlib.sha256(path.read_bytes()).hexdigest())
'
