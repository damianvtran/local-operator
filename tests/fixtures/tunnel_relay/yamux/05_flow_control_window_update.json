{
  "name": "05_flow_control_window_update",
  "contract": "docs/TUNNEL_RELAY.md C1",
  "deterministic": false,
  "invariants": [
    "frames[0..3] are byte-exact (control handshake)",
    "stream 1 opens with relay WindowUpdate SYN length 786432 and device WindowUpdate ACK length 786432",
    "sum of Data payload lengths on stream 1 == 1572864, payload byte i == i mod 251",
    "relay never has more unacknowledged Data bytes in flight than 262144 + every delta the device granted",
    "the device grants window (WindowUpdate, no flags) once it has consumed >= 524288 bytes since its last grant",
    "exact Data frame sizes and WindowUpdate deltas depend on scheduling; do NOT assert them"
  ],
  "description": "Relay writes 1572864 bytes (byte i = i mod 251) on stream 1. The SYN/ACK grants each side a 1 MiB receive window (256 KiB implicit + 786432 delta); the relay blocks after 1048576 bytes until the device, having consumed at least half its window, sends a WindowUpdate. Payloads over 4096 bytes are recorded as sha256 only.",
  "generator": "hashicorp/yamux v0.1.2, relay=yamux.Client, device=yamux.Server, MaxStreamWindowSize=1048576, keepalive disabled while recording",
  "steps": [
    "control handshake",
    "relay OpenStream (1) + Write(1572864 bytes)",
    "device AcceptStream + ReadFull"
  ],
